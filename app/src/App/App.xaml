<?xml version="1.0" encoding="utf-8"?>
<!-- URnetwork app resources. The app runs the brand dark theme (macOS parity):
     #101010 background, #1C1C1C cards, pale yellow accent for primary actions,
     brand blue for switch on-states. The Ur* brushes mirror UrColors.h - keep
     the two in sync.
     SPDX-License-Identifier: MPL-2.0 -->
<Application
    x:Class="URnetwork.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />

                <!-- Overrides of WinUI's OWN theme resources have to be merged
                     AFTER XamlControlsResources. They used to live in this
                     dictionary's own ThemeDictionaries, where the entire block
                     was silently inert: the Get started button rendered #4CC2FF
                     (the dark-theme system accent, Light2 of the machine's
                     #0078D4) and every templated control kept Segoe UI - while
                     top-level keys in this same file, like UrHeadingFontFamily,
                     resolved fine. Later merged dictionaries win, and this is
                     the lookup a control template actually reaches. -->
                <ResourceDictionary>
                    <ResourceDictionary.ThemeDictionaries>
                        <!-- "Default" is the dark dictionary; the app requests Dark. -->
                        <ResourceDictionary x:Key="Default">
                            <!-- pale yellow accent for primary buttons (Connect, dialog
                                 primaries), with dark text for contrast. NOTE: the login
                                 screen does NOT use this - android's URButton PRIMARY is
                                 BlueMedium, see UrPrimaryButtonStyle below. -->
                            <SolidColorBrush x:Key="AccentButtonBackground" Color="#EFF7BB" />
                            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#F5FBD1" />
                            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#D9E3A3" />
                            <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="#33EFF7BB" />
                            <SolidColorBrush x:Key="AccentButtonForeground" Color="#101010" />
                            <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#101010" />
                            <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#101010" />
                            <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="#66101010" />
                            <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="Transparent" />
                            <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="Transparent" />
                            <!-- brand blue switch on-state -->
                            <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#638BFC" />
                            <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#7FA0FC" />
                            <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#5378E0" />
                            <SolidColorBrush x:Key="ToggleSwitchFillOnDisabled" Color="#33638BFC" />
                            <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#638BFC" />
                            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="#7FA0FC" />
                            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="#5378E0" />
                            <!-- android's onBackground is OFF-white (#F8F8F8), not pure
                                 white: this is the default foreground every unstyled
                                 TextBlock and control text in the app picks up -->
                            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#F8F8F8" />
                            <!-- the body face as the default for every TEMPLATED control
                                 (buttons, text boxes, list views, ContentDialog chrome).
                                 Those do not pick up a FontFamily set further up the tree
                                 - their own style setter beats an inherited value - and
                                 this key is what that setter reads. -->
                            <FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Assets/Fonts/pp_neue_montreal_regular.ttf#PP Neue Montreal</FontFamily>

                            <!-- URTextInput (android ui/components/URTextInput.kt) is not
                                 a filled box: it is a transparent field over a 1dp
                                 HorizontalDivider that is TextFaint at rest, BlueMedium
                                 while focused and Transparent when disabled, with the
                                 placeholder in TextFaint and the text itself LightGray.
                                 Every text field in the app is that component, so these
                                 go on the theme resources rather than a single style. -->
                            <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBorderBrush" Color="#5A5A5A" />
                            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#5A5A5A" />
                            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#638BFC" />
                            <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlForeground" Color="#D3D3D3" />
                            <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#D3D3D3" />
                            <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#D3D3D3" />
                            <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#5A5A5A" />
                            <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#5A5A5A" />
                            <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#5A5A5A" />
                            <!-- WinUI thickens the underline to 2px on focus; android
                                 keeps 1dp and only changes its colour -->
                            <Thickness x:Key="TextControlBorderThemeThickness">0,0,0,1</Thickness>
                            <Thickness x:Key="TextControlBorderThemeThicknessFocused">0,0,0,1</Thickness>

                            <!-- NavigationView paints its own content-area layer
                                 OVER the root grid's brand background, and in
                                 WinUI's dark theme that layer lands on #1C1C1C -
                                 byte-identical to UrCardBrush. So every UrCard on
                                 every destination was drawing an invisible card:
                                 measured on a real capture, the content area and
                                 the inside of a card were both #1C1C1C while the
                                 title bar (outside the NavigationView) was the
                                 correct #101010.

                                 This is a whole-app defect, not one screen's: it
                                 makes the card system - the thing every panel is
                                 assembled from - produce no observable signal.
                                 Transparent lets the root grid's #101010 through,
                                 which is what the palette says the page is. -->
                            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                            <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
                            <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
                            <CornerRadius x:Key="NavigationViewContentGridCornerRadius">0</CornerRadius>

                            <!-- THE PANE. The line above only fixed the CONTENT
                                 layer; the pane itself was never overridden, so
                                 it kept WinUI's default, which is ACRYLIC. An
                                 acrylic pane samples the desktop behind the
                                 window, so on a signed-in app over a bright
                                 desktop it renders as a pale grey slab with the
                                 wallpaper's colours smeared through it -
                                 measured #2E2E2E with a visible yellow-green
                                 cast off whatever was underneath. That is the
                                 owner's "bright white when I click on menu".
                                 The app is a solid-surface dark theme; the pane
                                 is a surface, so it gets the card colour.
                                 This survived review because PrintWindow does
                                 NOT composite acrylic - a PrintWindow capture
                                 shows a flat dark rectangle and lies. Verify
                                 with CopyFromScreen of an ACTIVE window.
                                   Default   = docked pane (Left / LeftCompact)
                                   Expanded  = the overlay flyout (LeftMinimal,
                                               and LeftCompact once opened)
                                   Top       = the horizontal bar
                                 All three, because the display mode adapts with
                                 the window width and only one of them was ever
                                 on screen at a time. -->
                            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#151515" />
                            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#151515" />
                            <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="#151515" />
                            <!-- the SplitView the pane is hosted in has its own key -->
                            <SolidColorBrush x:Key="SplitViewPaneBackground" Color="#151515" />
                            <!-- the rail needs an EDGE against the page, or a
                                 #151515 pane on a #101010 page is a difference
                                 nobody can see -->
                            <SolidColorBrush x:Key="NavigationViewItemSeparatorForeground" Color="#1FFFFFFF" />
                            <!-- selected destination: the brand accent bar and a
                                 card-coloured pill, rather than the system accent -->
                            <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#EFF7BB" />
                            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#242424" />
                            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#2A2A2A" />
                            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed" Color="#2A2A2A" />
                            <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#1C1C1C" />
                            <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="#242424" />
                            <SolidColorBrush x:Key="NavigationViewItemForeground" Color="#989898" />
                            <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#F8F8F8" />
                            <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="#F8F8F8" />
                            <SolidColorBrush x:Key="NavigationViewItemForegroundPressed" Color="#F8F8F8" />
                            <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPointerOver" Color="#F8F8F8" />
                            <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPressed" Color="#F8F8F8" />
                        </ResourceDictionary>
                    </ResourceDictionary.ThemeDictionaries>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>

            <!-- Brand faces (android ui/theme/Type.kt; files in Assets/Fonts,
                 copied next to the exe by App.vcxproj). The part after '#' is the
                 font's OWN internal family name, read from each file's OpenType
                 'name' table (name id 1) - NOT the file name, and not a guess:
                   abcgravity_extended.otf        -> "ABC Gravity Extended"
                   abcgravity_extra_condensed.otf -> "ABC Gravity Extra Condensed"
                   pp_neue_montreal_regular.ttf   -> "PP Neue Montreal"
                   pp_neue_bit_bold.ttf           -> "PP NeueBit"   (note: no space
                                                     in "NeueBit"; the Bold face is
                                                     the only one in the file)
                 Get one of these wrong and there is no error - the text silently
                 renders in the fallback font. Role mapping, from Type.kt:
                   headlineLarge  = ABC Gravity Extended        32sp/36sp
                   headlineMedium = ABC Gravity Extra Condensed 32sp/32sp
                   headlineSmall  = ABC Gravity Extended        24sp/32sp
                   TopBarTitle    = PP NeueBit Bold             24sp -> the wordmark
                   buttonTextStyle = PP NeueBit Bold            24sp -> every URButton
                   body*          = PP Neue Montreal            16/14/12sp -->
            <FontFamily x:Key="UrHeadingFontFamily">ms-appx:///Assets/Fonts/abcgravity_extended.otf#ABC Gravity Extended</FontFamily>
            <FontFamily x:Key="UrHeadingCondensedFontFamily">ms-appx:///Assets/Fonts/abcgravity_extra_condensed.otf#ABC Gravity Extra Condensed</FontFamily>
            <FontFamily x:Key="UrBodyFontFamily">ms-appx:///Assets/Fonts/pp_neue_montreal_regular.ttf#PP Neue Montreal</FontFamily>
            <FontFamily x:Key="UrWordmarkFontFamily">ms-appx:///Assets/Fonts/pp_neue_bit_bold.ttf#PP NeueBit</FontFamily>

            <!-- brand palette (mirrors UrColors.h) -->
            <SolidColorBrush x:Key="UrBackgroundBrush" Color="#101010" />
            <!-- sheet surface: android SheetBlack = Black.lighten(0.03), which
                 Compose lerps in Oklab, so #101010 lifts to #151515 -->
            <SolidColorBrush x:Key="UrSheetBrush" Color="#151515" />
            <SolidColorBrush x:Key="UrCardBrush" Color="#1C1C1C" />
            <!-- card hover / pressed. These two values used to be applied from
                 code, by a WireCardAffordances helper that hand-wired
                 PointerEntered/Exited/Pressed on plain Borders; that helper is
                 gone and the UrCardButton template below is the only thing that
                 spends them. -->
            <SolidColorBrush x:Key="UrCardHoverBrush" Color="#242424" />
            <SolidColorBrush x:Key="UrCardPressedBrush" Color="#2A2A2A" />
            <SolidColorBrush x:Key="UrBorderBrush" Color="#1FFFFFFF" />
            <!-- the same edge, one step up, for a card the pointer is over: the
                 hover fill alone moves #1C1C1C to #242424, which is under the
                 just-noticeable difference on most panels. -->
            <SolidColorBrush x:Key="UrBorderStrongBrush" Color="#38FFFFFF" />
            <SolidColorBrush x:Key="UrTextBrush" Color="#F8F8F8" />
            <SolidColorBrush x:Key="UrTextMutedBrush" Color="#989898" />
            <SolidColorBrush x:Key="UrTextFaintBrush" Color="#5A5A5A" />
            <SolidColorBrush x:Key="UrDangerBrush" Color="#F8523B" />
            <SolidColorBrush x:Key="UrAccentBrush" Color="#EFF7BB" />
            <SolidColorBrush x:Key="UrGreenBrush" Color="#87FB67" />
            <SolidColorBrush x:Key="UrPinkBrush" Color="#ED8FFF" />
            <SolidColorBrush x:Key="UrCoralBrush" Color="#FF6C58" />
            <!-- android Blue400 / BlueMedium: the URButton PRIMARY container and
                 the focused URTextInput underline -->
            <SolidColorBrush x:Key="UrBlueMediumBrush" Color="#638BFC" />
            <!-- android Red400 / Red: URInlineErrorText -->
            <SolidColorBrush x:Key="UrErrorTextBrush" Color="#FF6C58" />
            <!-- Pro gold. Reserved for the Pro entitlement across the product and
                 used for NOTHING else, so gold reads as "this account is Pro"
                 rather than as decoration. -->
            <SolidColorBrush x:Key="UrProGoldBrush" Color="#FFC400" />
            <SolidColorBrush x:Key="UrProGoldLightBrush" Color="#FFE082" />
            <!-- connect status dot: android circle_indicator_{green,yellow,blue} -->
            <SolidColorBrush x:Key="UrStatusConnectingBrush" Color="#E6EA23" />
            <SolidColorBrush x:Key="UrStatusIdleBrush" Color="#2A60FF" />
            <!-- coral at 15% alpha: the unapplied-dns-recommendation pill background
                 (iOS Color.urCoral.opacity(0.15)) -->
            <SolidColorBrush x:Key="UrCoralSubtleBrush" Color="#26FF6C58" />

            <!-- ================= URButton (android ui/components/URButton.kt) =========
                 One template, two styles, so the login screen's buttons are the same
                 component android's are:
                   PRIMARY   containerColor BlueMedium #638BFC, contentColor White
                   SECONDARY containerColor White,              contentColor Black
                 shape RoundedCornerShape(12.dp), defaultMinSize(minHeight = 48.dp),
                 fillMaxWidth, and buttonTextStyle = ppNeueBitBold at 24.sp.

                 Hover and press are drawn the way Material does it - a translucent
                 layer of the CONTENT colour over the container - rather than by
                 swapping the container brush. That is why one template covers both
                 styles and a Style only has to set Background/Foreground; swapping
                 brushes would need a separate set of per-state keys per style. -->
            <Style x:Key="UrButtonBaseStyle" TargetType="Button">
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="MinHeight" Value="48" />
                <Setter Property="Padding" Value="16,8" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="FontFamily" Value="{StaticResource UrWordmarkFontFamily}" />
                <Setter Property="FontSize" Value="24" />
                <!-- pp_neue_bit_bold.ttf carries a single face and it is Bold, so
                     state the weight rather than leaving it to nearest-match -->
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="Root"
                                  CornerRadius="{TemplateBinding CornerRadius}"
                                  Background="{TemplateBinding Background}"
                                  BorderBrush="{TemplateBinding BorderBrush}"
                                  BorderThickness="{TemplateBinding BorderThickness}">
                                <Grid x:Name="StateLayer"
                                      CornerRadius="{TemplateBinding CornerRadius}"
                                      Background="{TemplateBinding Foreground}"
                                      Opacity="0" />
                                <!-- The font properties MUST be template-bound. ContentPresenter
                                     declares its own FontFamily/FontSize/FontWeight with
                                     defaults, so they do not inherit from the templated
                                     parent: without these three lines the Style's
                                     PP NeueBit setter never reaches the button's content
                                     and the label silently renders in the body face. -->
                                <ContentPresenter x:Name="Presenter"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  Padding="{TemplateBinding Padding}"
                                                  Foreground="{TemplateBinding Foreground}"
                                                  FontFamily="{TemplateBinding FontFamily}"
                                                  FontSize="{TemplateBinding FontSize}"
                                                  FontWeight="{TemplateBinding FontWeight}"
                                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  AutomationProperties.AccessibilityView="Raw" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="StateLayer.Opacity" Value="0.08" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="StateLayer.Opacity" Value="0.12" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Opacity" Value="0.38" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="UrPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource UrButtonBaseStyle}">
                <Setter Property="Background" Value="{StaticResource UrBlueMediumBrush}" />
                <Setter Property="Foreground" Value="White" />
            </Style>

            <Style x:Key="UrSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource UrButtonBaseStyle}">
                <Setter Property="Background" Value="White" />
                <Setter Property="Foreground" Value="Black" />
            </Style>

            <!-- URTextInputLabel: 12sp in TextMuted, 8dp above the field -->
            <Style x:Key="UrTextInputLabelStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource UrBodyFontFamily}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{StaticResource UrTextMutedBrush}" />
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>

            <!-- the field itself; the state colours come from the TextControl*
                 theme resources above -->
            <Style x:Key="UrTextInputStyle" TargetType="TextBox">
                <Setter Property="FontFamily" Value="{StaticResource UrBodyFontFamily}" />
                <Setter Property="FontSize" Value="16" />
                <!-- an underline must not curve at its ends -->
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="Padding" Value="0,0,0,8" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
            </Style>

            <!-- URInlineErrorText: bodySmall in Red400, full width -->
            <Style x:Key="UrInlineErrorTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource UrBodyFontFamily}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{StaticResource UrErrorTextBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <!-- ================= the rest of the component kit ===================
                 iOS ships UrButton, UrCard, UrTextField, UrSwitchToggle, UrSnackbar
                 and UrLabel (Shared/Views/Components/). Windows had only URButton.
                 These are the others, as the same thing URButton is: NATIVE WinUI
                 controls and metrics — real visual states, real focus, real
                 automation peers — wearing the brand palette and faces. Nothing
                 here reimplements a control; where iOS hand-draws a switch track,
                 this skins the platform one.

                 Colours come from the Ur* tokens above (mirrored from UrColors.h).
                 Do not put a literal colour in a style below. -->

            <!-- ==== UrLabel (Components/UrLabel.swift) ========================
                 secondaryBodyFont in textMuted. The caption above a value, the
                 supporting line under a field, a card's section label. -->
            <Style x:Key="UrLabelStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource UrBodyFontFamily}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{StaticResource UrTextMutedBrush}" />
            </Style>

            <!-- UrTextField's supporting text: the same label role, but it wraps
                 (it carries sentences like "Network names must be 6 characters or
                 more") and its colour is driven by the validation state at
                 runtime — see urnw::kit::ApplySupportingText (UrComponents.h),
                 which is the ValidationState.swift port. -->
            <Style x:Key="UrSupportingTextStyle" TargetType="TextBlock" BasedOn="{StaticResource UrLabelStyle}">
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <!-- ==== UrCard (Components/UrCard.swift) ==========================
                 tintedBackgroundBase, 12dp radius, one padding step. The optional
                 label ABOVE the surface is PP NeueBit 22 bold in the text colour
                 (iOS UrCard cardLabel), not the muted 12sp caption most of the
                 current cards use inside themselves. -->
            <!-- THE EDGE. Card fill is #1C1C1C on a #101010 page: 6 levels of
                 luminance, which is a difference the eye does not reliably
                 resolve at panel scale. Without a border the cards did not read
                 as objects at all and the app came out, in the owner's words,
                 "just buttons on a black screen". kBorder (#1FFFFFFF) has been
                 in UrColors.h since the palette landed and was applied to
                 nothing. One hairline is the whole difference between a tint
                 and a module. -->
            <Style x:Key="UrCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource UrCardBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource UrBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="16" />
            </Style>

            <!-- ==== structure primitives =====================================
                 The three shapes every panel in the app was open-coding, so that
                 "a divider" is one decision rather than fourteen. -->

            <!-- a rule between rows inside a card. Was
                 <Border Height="1" Background="{StaticResource UrBorderBrush}"/>
                 copy-pasted at each site; Settings had them and read best,
                 Connect had none and read as a void. -->
            <Style x:Key="UrDividerStyle" TargetType="Border">
                <Setter Property="Height" Value="1" />
                <Setter Property="Background" Value="{StaticResource UrBorderBrush}" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
            </Style>

            <!-- the heading ABOVE a card ("Payout Wallets", "Device"), 16/
                 SemiBold in the display face. Nine sites spelled these three
                 setters out inline. -->
            <Style x:Key="UrSectionHeadingStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource UrHeadingFontFamily}" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource UrTextBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- the larger variant that names a whole panel section -->
            <Style x:Key="UrPanelHeadingStyle" TargetType="TextBlock" BasedOn="{StaticResource UrSectionHeadingStyle}">
                <Setter Property="FontSize" Value="18" />
            </Style>

            <!-- ==== icons ====================================================
                 Windows 11 ships Segoe Fluent Icons, so every standard
                 affordance in this app - chevron, copy, wallet, shield, gear,
                 warning, check - is a glyph we already have and do not have to
                 draw, package or license. The app shipped ZERO of them against
                 iOS's 16 ur.symbols; a list row with no leading mark is the
                 single largest reason a panel reads as text on black.

                 Naming the family matters: FontIcon defaults to the OLDER
                 "Segoe MDL2 Assets", whose metrics differ, so a mixed screen
                 comes out with two icon weights. -->
            <FontFamily x:Key="UrIconFontFamily">Segoe Fluent Icons</FontFamily>

            <!-- the leading mark on a row or a section header -->
            <Style x:Key="UrRowIconStyle" TargetType="FontIcon">
                <Setter Property="FontFamily" Value="{StaticResource UrIconFontFamily}" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="Foreground" Value="{StaticResource UrTextMutedBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <!-- decoration beside a label that already says the same thing -->
                <Setter Property="AutomationProperties.AccessibilityView" Value="Raw" />
            </Style>

            <!-- the trailing "this row opens something" chevron. Quieter than a
                 leading mark on purpose: it is an affordance, not information. -->
            <Style x:Key="UrChevronIconStyle" TargetType="FontIcon" BasedOn="{StaticResource UrRowIconStyle}">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="{StaticResource UrTextFaintBrush}" />
                <Setter Property="HorizontalAlignment" Value="Right" />
            </Style>

            <!-- the mark over an empty state's sentence -->
            <Style x:Key="UrEmptyGlyphStyle" TargetType="FontIcon" BasedOn="{StaticResource UrRowIconStyle}">
                <Setter Property="FontSize" Value="28" />
                <Setter Property="Foreground" Value="{StaticResource UrTextFaintBrush}" />
                <Setter Property="HorizontalAlignment" Value="Center" />
            </Style>

            <!-- ==== stat tile ================================================
                 Wallet's header row and the Developer metric rows are the two
                 densest surfaces in the app and the two the owner has said work.
                 The shape is a muted 12sp caption over a big condensed number;
                 these are that shape, so the rest of the app can use it instead
                 of re-deriving it. -->
            <Style x:Key="UrStatLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource UrLabelStyle}">
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <Style x:Key="UrStatValueStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource UrHeadingCondensedFontFamily}" />
                <Setter Property="FontSize" Value="26" />
                <Setter Property="Foreground" Value="{StaticResource UrTextBrush}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <!-- the same tile, boxed, for a row of them that needs its own
                 edges (the metric strip on a page that has no card around it) -->
            <Style x:Key="UrStatTileStyle" TargetType="Border" BasedOn="{StaticResource UrCardStyle}">
                <Setter Property="Padding" Value="16,12" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>

            <Style x:Key="UrCardLabelStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource UrWordmarkFontFamily}" />
                <Setter Property="FontSize" Value="22" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Foreground" Value="{StaticResource UrTextBrush}" />
            </Style>

            <!-- A card the user can ACTIVATE is a Button, not a Border with a
                 Tapped handler. That is the whole difference between the two
                 styles here, and it is not cosmetic: a Border is not in the tab
                 order, cannot be reached or fired from the keyboard, draws no
                 focus rectangle, and exposes no automation peer, so a screen
                 reader never learns the card is actionable. A Button gets all
                 four from the platform, and its CommonStates give the hover and
                 press feedback that MainWindow used to hand-wire with five
                 pointer-event handlers per card.

                 UseSystemFocusVisuals is left on so the focus rectangle is the
                 system's, at the system's thickness. -->
            <Style x:Key="UrCardButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource UrCardBrush}" />
                <Setter Property="Foreground" Value="{StaticResource UrTextBrush}" />
                <!-- the same hairline UrCardStyle carries: an actionable card
                     and a static one are the same object and must have the same
                     edge, or the page grows two card species. The template's
                     Root is a Grid, which in WinUI does render BorderBrush /
                     BorderThickness / CornerRadius. -->
                <Setter Property="BorderBrush" Value="{StaticResource UrBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="16" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="FontFamily" Value="{StaticResource UrBodyFontFamily}" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="Root"
                                  CornerRadius="{TemplateBinding CornerRadius}"
                                  Background="{TemplateBinding Background}"
                                  BorderBrush="{TemplateBinding BorderBrush}"
                                  BorderThickness="{TemplateBinding BorderThickness}">
                                <!-- FontSize and FontWeight are template-bound for the same
                                     reason UrButtonBaseStyle spells out above: ContentPresenter
                                     declares its own defaults for all three font properties, so
                                     they do not inherit from the templated parent and a Style
                                     setter would silently never reach the content. -->
                                <ContentPresenter x:Name="Presenter"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  Padding="{TemplateBinding Padding}"
                                                  Foreground="{TemplateBinding Foreground}"
                                                  FontFamily="{TemplateBinding FontFamily}"
                                                  FontSize="{TemplateBinding FontSize}"
                                                  FontWeight="{TemplateBinding FontWeight}"
                                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="{StaticResource UrCardHoverBrush}" />
                                                <!-- #1C1C1C -> #242424 is 8 levels;
                                                     lifting the edge as well is what
                                                     actually reads as "this one" -->
                                                <Setter Target="Root.BorderBrush" Value="{StaticResource UrBorderStrongBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="{StaticResource UrCardPressedBrush}" />
                                                <Setter Target="Root.BorderBrush" Value="{StaticResource UrBorderStrongBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Opacity" Value="0.38" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- the same card, at row scale: a tappable line inside another card
                 (the selected-provider row, the peers line) -->
            <Style x:Key="UrCardRowButtonStyle" TargetType="Button" BasedOn="{StaticResource UrCardButtonStyle}">
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="12,8" />
                <!-- NO edge: this row sits INSIDE a card that already has one,
                     and a bordered box inside a bordered box reads as two
                     parallel hairlines 16px apart rather than as nesting. The
                     row's structure comes from the divider above it and its
                     hover fill; its edge would be noise. -->
                <Setter Property="BorderThickness" Value="0" />
            </Style>

            <!-- A row inside a card that is NOT a button: the same 12,8 metrics
                 so a tappable row and a static one line up on the same left
                 edge. Without this every static row was inset 12px less than
                 the tappable one above it, which is visible as a ragged column
                 of labels. -->
            <Style x:Key="UrCardRowStyle" TargetType="Border">
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
            </Style>

            <!-- ==== UrSwitchToggle (Components/UrSwitchToggle.swift) ==========
                 iOS hand-draws a 40x22 track. Windows does NOT: the platform
                 ToggleSwitch already has the right metrics, the right pointer and
                 focus states and a real automation peer, and its on-state fill is
                 already the brand blue through the ToggleSwitchFillOn* theme keys
                 above. All this style does is drop the On/Off word labels (the
                 row's own TextBlock is the label) and stop the control reserving
                 WinUI's default 154px minimum width for them.

                 Pair every instance with AutomationProperties.LabeledBy pointing
                 at that TextBlock, or the switch is nameless to a screen reader. -->
            <Style x:Key="UrSwitchToggleStyle" TargetType="ToggleSwitch">
                <Setter Property="OnContent" Value="" />
                <Setter Property="OffContent" Value="" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- ==== UrTextField, secure variant ===============================
                 UrTextInputStyle above is the TextBox half; a PasswordBox is a
                 different TargetType and so needs its own, with the same
                 underline treatment (the colours come from the TextControl*
                 theme keys, which both controls read). -->
            <Style x:Key="UrPasswordInputStyle" TargetType="PasswordBox">
                <Setter Property="FontFamily" Value="{StaticResource UrBodyFontFamily}" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="Padding" Value="0,0,0,8" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
            </Style>

            <!-- ==== UrSnackbar (Components/UrSnackbar/UrSnackBar.swift) =======
                 iOS slides a transient bar up from the bottom. The Windows idiom
                 for a transient, non-blocking status message is InfoBar, so that
                 is what this is — but InfoBar has no dismissal timer of its own,
                 which is the one thing that makes a snackbar a snackbar. The
                 timer lives in urnw::kit::Snackbar (UrComponents.h); this style
                 is the surface it shows on. -->
            <Style x:Key="UrSnackbarStyle" TargetType="InfoBar">
                <Setter Property="FontFamily" Value="{StaticResource UrBodyFontFamily}" />
                <Setter Property="IsClosable" Value="True" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
