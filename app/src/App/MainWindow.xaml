<?xml version="1.0" encoding="utf-8"?>
<!-- URnetwork main window. Sign-in flow (initial → password / create / verify /
     reset — macOS Authenticate/** parity), then a NavigationView home with the
     macOS sections: Connect, Account, Wallet, Leaderboard, Support, Settings.
     Each home panel is driven by MainWindow code-behind over the SDK Api.

     No user-facing text lives in this file: every label is named and set from the
     shared localization store in MainWindow::ApplyStrings (Localization.h). Tags
     ("connect", "phantom", ...) are internal identifiers, not UI text.
     SPDX-License-Identifier: MPL-2.0 -->
<Window
    x:Class="URnetwork.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <Grid Background="{StaticResource UrBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <!-- Row 2 carries the persistent session-mode notice (P2). Appended
                 rather than inserted so no existing element's Grid.Row moves:
                 four phases share this file. -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The title bar. ExtendsContentIntoTitleBar puts the window's content
             under the system caption buttons; SetTitleBar(AppTitleBar) is what
             makes this strip the DRAG region, which is the difference between a
             wordmark drawn where a title bar would be and an actual title bar.
             Height 40 leaves the caption buttons (32 tall, drawn by the system
             at the top right) clear of the wordmark's descenders.

             The wordmark itself: android sets its top-bar title in PP NeueBit
             Bold at 24sp (Type.kt TopBarTitleTextStyle). The file carries only a
             Bold face, so the weight is stated rather than left to be
             synthesised. -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="40" Background="Transparent">
            <TextBlock x:Name="BrandText" Margin="16,0" VerticalAlignment="Center"
                       FontFamily="{StaticResource UrWordmarkFontFamily}"
                       FontSize="24" FontWeight="Bold"
                       IsHitTestVisible="False" />
        </Grid>

        <!-- Sign-in flow: one step visible at a time (ShowLoginStep).
             FontFamily here is the BODY face for everything inside: font
             properties inherit down the XAML tree, so the bare TextBlocks in
             these panels pick it up without being touched one by one. The
             headings below override it, and templated controls take it from
             ContentControlThemeFontFamily instead (a style setter beats an
             inherited value). -->
        <ScrollViewer x:Name="LoginRoot" Grid.Row="1"
                      FontFamily="{StaticResource UrBodyFontFamily}"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <Grid>

                <!-- Initial: account discovery (email/phone), wallets, auth code.
                     Structure is android ungoogle/LoginInitial.kt LoginInitialActions,
                     in its order: field, Get started, "or", then the secondary
                     sign-in options. The column is widthIn(max = 512.dp) inside a
                     centred Row, and every gap between elements is 16dp.

                     There is deliberately NO "Sign in" heading here: android has none
                     on the initial screen, the carousel above supplies the headline.
                     There is also no guest-mode button - it does not exist in the
                     android login, and guest mode is superseded by the seedphrase
                     system. -->
                <!-- Stretch, NOT Center: a centred StackPanel sizes to its widest
                     child, so MaxWidth never binds and the column came out about
                     230px wide instead of android's 512. Stretch takes the whole
                     slot, MaxWidth clamps it, and the layout centres the rest. -->
                <StackPanel x:Name="LoginPanel" Margin="16" Spacing="16"
                            MaxWidth="512" HorizontalAlignment="Stretch"
                            VerticalAlignment="Center">

                    <!-- URTextInput: label, then the underlined field. Spacing is 0
                         here because the label style carries android's 8dp gap and
                         the field owns the padding above its underline. -->
                    <StackPanel Spacing="0">
                        <TextBlock x:Name="EmailLabel" Style="{StaticResource UrTextInputLabelStyle}" />
                        <TextBox x:Name="EmailBox" Style="{StaticResource UrTextInputStyle}" />
                    </StackPanel>

                    <Button x:Name="GetStartedButton"
                            Style="{StaticResource UrPrimaryButtonStyle}"
                            Click="OnGetStarted" />

                    <TextBlock x:Name="OrDivider" HorizontalAlignment="Center"
                               FontFamily="{StaticResource UrBodyFontFamily}"
                               Foreground="{StaticResource UrTextMutedBrush}" />

                    <!-- Wallet sign in through the ur.io/wallet-connect browser bridge
                         (desktop wallets are browser extensions, not deeplink apps). -->
                    <Button x:Name="BittensorSignInButton"
                            Style="{StaticResource UrSecondaryButtonStyle}"
                            Click="OnSignInWithBittensor">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <!-- android res/drawable/bittensor_logo.xml, converted by
                                 tools/vd2xaml.py. Upstream its fillColor is #FFFFFFFF,
                                 which is invisible on the white SECONDARY button it
                                 sits on over there; drawn here in the button's content
                                 colour so it can actually be seen. -->
                            <Viewbox Width="18" Height="18" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="Black" Data="M6,7 L18,7 L18,9.2 L13.3,9.2 L13.3,13.9 C13.3,15.02 13.94,15.6 15.1,15.6 L15.7,15.6 L15.7,17 L14.7,17 C12.35,17 10.9,15.82 10.9,13.9 L10.9,9.2 L6,9.2 Z" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock x:Name="BittensorSignInText" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- ONE Solana button, as android has. The bridge needs a provider
                         up front, so this presents a wallet chooser - the desktop
                         analogue of android's Mobile Wallet Adapter picker. -->
                    <Button x:Name="SolanaSignInButton"
                            Style="{StaticResource UrSecondaryButtonStyle}"
                            Click="OnSignInWithSolana">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Viewbox Width="18" Height="18" VerticalAlignment="Center">
                                <Canvas Width="101" Height="88">
                                    <Path Data="M100.48,69.38L83.81,86.8C83.44,87.18 83.01,87.48 82.52,87.69C82.03,87.89 81.51,88 80.97,88H1.94C1.56,88 1.19,87.89 0.87,87.69C0.56,87.49 0.31,87.2 0.16,86.87C0.01,86.53 -0.04,86.16 0.03,85.79C0.09,85.43 0.26,85.1 0.52,84.83L17.21,67.41C17.57,67.03 18,66.73 18.49,66.52C18.98,66.32 19.5,66.21 20.03,66.21H99.06C99.44,66.21 99.81,66.32 100.13,66.52C100.44,66.72 100.69,67.01 100.84,67.34C100.99,67.68 101.04,68.05 100.97,68.42C100.91,68.78 100.74,69.11 100.48,69.38ZM83.81,34.3C83.44,33.92 83.01,33.62 82.52,33.42C82.03,33.21 81.51,33.1 80.97,33.1H1.94C1.56,33.1 1.19,33.21 0.87,33.41C0.56,33.62 0.31,33.9 0.16,34.24C0.01,34.58 -0.04,34.95 0.03,35.31C0.09,35.67 0.26,36.01 0.52,36.28L17.21,53.7C17.57,54.07 18,54.38 18.49,54.58C18.98,54.79 19.5,54.89 20.03,54.9H99.06C99.44,54.9 99.81,54.79 100.13,54.59C100.44,54.38 100.69,54.1 100.84,53.76C100.99,53.42 101.04,53.05 100.97,52.69C100.91,52.33 100.74,51.99 100.48,51.72L83.81,34.3ZM1.94,21.79H80.97C81.51,21.79 82.03,21.68 82.52,21.48C83.01,21.27 83.44,20.97 83.81,20.59L100.48,3.17C100.74,2.9 100.91,2.57 100.97,2.21C101.04,1.84 100.99,1.47 100.84,1.13C100.69,0.8 100.44,0.51 100.13,0.31C99.81,0.11 99.44,0 99.06,0L20.03,0C19.5,0 18.98,0.11 18.49,0.31C18,0.52 17.57,0.82 17.21,1.2L0.52,18.62C0.27,18.89 0.1,19.22 0.03,19.58C-0.03,19.95 0.01,20.32 0.16,20.65C0.31,20.99 0.56,21.28 0.88,21.48C1.19,21.68 1.56,21.79 1.94,21.79Z">
                                        <Path.Fill>
                                            <LinearGradientBrush MappingMode="Absolute" StartPoint="8.53,90.1" EndPoint="88.99,-3.02">
                                                <GradientStop Offset="0.08" Color="#FF9945FF" />
                                                <GradientStop Offset="0.3" Color="#FF8752F3" />
                                                <GradientStop Offset="0.5" Color="#FF5497D5" />
                                                <GradientStop Offset="0.6" Color="#FF43B4CA" />
                                                <GradientStop Offset="0.72" Color="#FF28E0B9" />
                                                <GradientStop Offset="0.97" Color="#FF19FB9B" />
                                            </LinearGradientBrush>
                                        </Path.Fill>
                                    </Path>
                                </Canvas>
                            </Viewbox>
                            <TextBlock x:Name="SolanaSignInText" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- android opens AuthCodeLoginSheet rather than showing an inline
                         field; the desktop equivalent is a dialog. -->
                    <Button x:Name="AuthCodeButton"
                            Style="{StaticResource UrSecondaryButtonStyle}"
                            Click="OnUseCode">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Viewbox Width="18" Height="18" VerticalAlignment="Center">
                                <Canvas Width="32" Height="32">
                                    <Path Fill="Black" Data="M30.48,10.67H32v10.66h-1.52Z M28.95,21.33h1.53v1.53h-1.53Z M28.95,9.14h1.53v1.53h-1.53Z M3.05,22.86h25.9v1.52H3.05Z M21.34,16.76h7.61v1.52h-7.61Z M18.29,16.76h1.52v1.52h-1.52Z M3.05,7.62h25.9v1.52H3.05Z M1.52,9.14h1.53v1.53H1.52Z M1.52,21.33h1.53v1.53H1.52Z M0,10.67h1.52v10.66H0Z M6.1,12.19h1.52v7.62H6.1Z M9.14,12.19h1.53v7.62H9.14Z M12.19,12.19h1.52v7.62h-1.52Z M16.76,12.19h1.53v7.62h-1.53Z M21.34,12.19h1.52v7.62h-1.52Z M25.9,12.19h1.53v7.62H25.9Z" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock x:Name="AuthCodeButtonText" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- URInlineErrorText, not an InfoBar -->
                    <TextBlock x:Name="LoginErrorText"
                               Style="{StaticResource UrInlineErrorTextStyle}"
                               Visibility="Collapsed" />
                </StackPanel>

                <!-- Password: an existing account signs in -->
                <StackPanel x:Name="PasswordPanel" Margin="24" Spacing="12"
                            MaxWidth="360" VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <Button x:Name="PasswordBackButton" Tag="initial" Click="OnLoginBack" />
                    <TextBlock x:Name="PasswordHeading" FontFamily="{StaticResource UrHeadingFontFamily}" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock x:Name="PasswordEmailText"
                               Foreground="{StaticResource UrTextMutedBrush}" />
                    <PasswordBox x:Name="PasswordBox" Style="{StaticResource UrPasswordInputStyle}"
                                 KeyDown="OnPasswordKeyDown" />
                    <Button x:Name="SignInButton"
                            Style="{StaticResource AccentButtonStyle}"
                            HorizontalAlignment="Stretch" Click="OnSignIn" />
                    <muxc:InfoBar x:Name="PasswordError" Severity="Error" IsOpen="False" IsClosable="False" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock x:Name="ForgotPasswordLabel" Style="{StaticResource UrLabelStyle}"
                                   VerticalAlignment="Center" />
                        <Button x:Name="ForgotResetButton" FontSize="12" Padding="4,2"
                                Background="Transparent" BorderThickness="0"
                                Click="OnForgotPassword" />
                    </StackPanel>
                </StackPanel>

                <!-- Create network: sign-up (email + password), a wallet that
                     isn't linked to a network yet (name + terms only), or the
                     guest network's upgrade to a full account (editable email;
                     MainWindow::EnterCreateStep drives the per-mode visibility) -->
                <StackPanel x:Name="CreatePanel" Margin="24" Spacing="12"
                            MaxWidth="360" VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <Button x:Name="CreateBackButton" Tag="initial" Click="OnLoginBack" />
                    <TextBlock x:Name="CreateHeading" FontFamily="{StaticResource UrHeadingFontFamily}" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock x:Name="WalletCreateNote" Style="{StaticResource UrSupportingTextStyle}"
                               Visibility="Collapsed"
                               />
                    <!-- guest upgrade (the plan card's create-account affordance):
                         status + call to action, and an editable email in place of
                         the echoed one -->
                    <TextBlock x:Name="GuestUpgradeNote" Style="{StaticResource UrSupportingTextStyle}"
                               Visibility="Collapsed"
                               />
                    <TextBlock x:Name="CreateEmailText"
                               Foreground="{StaticResource UrTextMutedBrush}" />
                    <TextBox x:Name="CreateEmailBox" Style="{StaticResource UrTextInputStyle}"
                             Visibility="Collapsed" TextChanged="OnCreateEmailChanged" />
                    <TextBox x:Name="CreateNameBox" Style="{StaticResource UrTextInputStyle}"
                             TextChanged="OnCreateNameChanged" />
                    <TextBlock x:Name="CreateNameStatusText" Style="{StaticResource UrSupportingTextStyle}"
                               />
                    <PasswordBox x:Name="CreatePasswordBox" Style="{StaticResource UrPasswordInputStyle}"
                                 PasswordChanged="OnCreatePasswordChanged" />
                    <TextBlock x:Name="CreatePasswordHint" Style="{StaticResource UrSupportingTextStyle}"
                               />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="TermsCheck" MinWidth="0" VerticalAlignment="Top"
                                  Checked="OnTermsChanged" Unchecked="OnTermsChanged" />
                        <!-- inlines with tappable terms/privacy links, set in code -->
                        <TextBlock x:Name="TermsText" Grid.Column="1" TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource UrTextMutedBrush}" />
                    </Grid>
                    <TextBox x:Name="BonusCodeBox" Style="{StaticResource UrTextInputStyle}"
                             TextChanged="OnBonusCodeChanged" />
                    <TextBlock x:Name="BonusStatusText" Style="{StaticResource UrSupportingTextStyle}"
                               />
                    <Button x:Name="CreateButton" IsEnabled="False"
                            Style="{StaticResource AccentButtonStyle}"
                            HorizontalAlignment="Stretch" Click="OnCreateNetwork" />
                    <muxc:InfoBar x:Name="CreateError" Severity="Error" IsOpen="False" IsClosable="False" />
                </StackPanel>

                <!-- Verify: the emailed / texted one-time code -->
                <StackPanel x:Name="VerifyPanel" Margin="24" Spacing="12"
                            MaxWidth="360" VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <Button x:Name="VerifyBackButton" Tag="initial" Click="OnLoginBack" />
                    <TextBlock x:Name="VerifyHeading" FontFamily="{StaticResource UrHeadingFontFamily}" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock x:Name="VerifyExplanationText" TextWrapping="Wrap"
                               Foreground="{StaticResource UrTextMutedBrush}" />
                    <TextBox x:Name="VerifyCodeBox" Style="{StaticResource UrTextInputStyle}"
                             MaxLength="6" TextChanged="OnVerifyCodeChanged" />
                    <Button x:Name="VerifyButton" IsEnabled="False"
                            Style="{StaticResource AccentButtonStyle}"
                            HorizontalAlignment="Stretch" Click="OnVerifySubmit" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock x:Name="DontSeeItLabel" Style="{StaticResource UrLabelStyle}"
                                   VerticalAlignment="Center" />
                        <Button x:Name="ResendCodeButton" FontSize="12" Padding="4,2"
                                Background="Transparent" BorderThickness="0"
                                Click="OnResendCode" />
                    </StackPanel>
                    <muxc:InfoBar x:Name="VerifyInfo" IsOpen="False" IsClosable="False" />
                </StackPanel>

                <!-- Password reset: send the reset link -->
                <StackPanel x:Name="ResetPanel" Margin="24" Spacing="12"
                            MaxWidth="360" VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <Button x:Name="ResetBackButton" Tag="password" Click="OnLoginBack" />
                    <TextBlock x:Name="ResetHeading" FontFamily="{StaticResource UrHeadingFontFamily}" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock x:Name="ResetEmailText"
                               Foreground="{StaticResource UrTextMutedBrush}" />
                    <TextBlock x:Name="ResetSpamNote" Style="{StaticResource UrSupportingTextStyle}" />
                    <Button x:Name="SendResetButton"
                            Style="{StaticResource AccentButtonStyle}"
                            HorizontalAlignment="Stretch" Click="OnSendResetLink" />
                    <muxc:InfoBar x:Name="ResetInfo" IsOpen="False" IsClosable="False" />
                </StackPanel>

            </Grid>
        </ScrollViewer>

        <!-- Home -->
        <!-- same body-face inheritance as LoginRoot, for the whole home tree -->
        <!-- IsSettingsVisible="False" is load-bearing: NavigationView adds its OWN
             settings gear by default, IN ADDITION to the explicit SettingsNavItem
             below. That gear's Tag matches none of the six destinations, so
             selecting it collapsed every panel and showed an empty window with no
             way back except picking another destination. -->
        <muxc:NavigationView x:Name="HomeNav" Grid.Row="1" Visibility="Collapsed"
                             FontFamily="{StaticResource UrBodyFontFamily}"
                             IsBackButtonVisible="Collapsed" PaneDisplayMode="LeftMinimal"
                             IsSettingsVisible="False"
                             SelectionChanged="OnNavSelectionChanged">
            <muxc:NavigationView.MenuItems>
                <muxc:NavigationViewItem x:Name="ConnectNavItem" Tag="connect" IsSelected="True" />
                <muxc:NavigationViewItem x:Name="AccountNavItem" Tag="account" />
                <muxc:NavigationViewItem x:Name="WalletNavItem" Tag="wallet" />
                <muxc:NavigationViewItem x:Name="LeaderboardNavItem" Tag="leaderboard" />
                <muxc:NavigationViewItem x:Name="SupportNavItem" Tag="support" />
                <muxc:NavigationViewItem x:Name="SettingsNavItem" Tag="settings" />
                <muxc:NavigationViewItem x:Name="DeveloperNavItem" Tag="developer" />
            </muxc:NavigationView.MenuItems>

            <Grid Margin="24">
                <!-- Connect: the connect drawer (macOS ConnectActions parity).
                     A scrollable column of cards capped at 600: connection
                     controls, client statistics, local statistics, custom DNS,
                     the ad/tracker blocker toggle, and the plan + usage card.
                     Charts render into the *ChartHost grids from code-behind
                     (TransferChart); the usage bar into DrawerUsageBarHost
                     (UsageBar). -->
                <ScrollViewer x:Name="ConnectView" HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="DrawerStack" Spacing="16" MaxWidth="600"
                                HorizontalAlignment="Stretch" Margin="0,0,0,24">

                        <!-- Connection controls -->
                        <Border x:Name="ControlsCard" Style="{StaticResource UrCardStyle}">
                            <StackPanel Spacing="12">
                                <!-- connect status (android ConnectStatusIndicator
                                     parity): a state-coloured dot + the four-state
                                     status line. Driven by the SDK's own connection
                                     status, NOT by the service tunnel alone, so
                                     "Connecting to providers" exists at all —
                                     see MainWindow::ApplyConnectStatus. -->
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse x:Name="StatusDot" Width="10" Height="10"
                                             VerticalAlignment="Center" />
                                    <!-- a Grid star column, not a horizontal StackPanel:
                                         the idle copy carries the network name, and a
                                         StackPanel would hand it infinite width so
                                         TextWrapping could never fire -->
                                    <TextBlock x:Name="StatusText" Grid.Column="1"
                                               FontSize="22" FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center" />
                                </Grid>
                                <!-- selected location; the whole row opens the provider chooser -->
                                <Button x:Name="LocationRow"
                                        Style="{StaticResource UrCardRowButtonStyle}"
                                        Click="OnLocationRowClick">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock x:Name="SelectedProviderLabel" FontSize="12"
                                               AutomationProperties.AccessibilityView="Raw"
                                                       Foreground="{StaticResource UrTextMutedBrush}" />
                                            <TextBlock x:Name="LocationText" FontSize="15"
                                                       AutomationProperties.AccessibilityView="Raw" />
                                        </StackPanel>
                                        <FontIcon Grid.Column="1" Glyph="&#xE76C;" FontSize="14"
                                                  VerticalAlignment="Center"
                                                  Foreground="{StaticResource UrTextMutedBrush}" />
                                    </Grid>
                                </Button>
                                <Button x:Name="ConnectButton"
                                        Style="{StaticResource AccentButtonStyle}"
                                        HorizontalAlignment="Stretch" Click="OnConnectToggle" />
                                <!-- network peers status line (apple ConnectActions parity): a
                                     filled dot (green when providing peers are online, coral at
                                     zero) + "{n} peers", always shown; tapping opens the chooser -->
                                <Button x:Name="PeersLine"
                                        Style="{StaticResource UrCardRowButtonStyle}"
                                        Click="OnPeersLineClick">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Ellipse x:Name="PeerDot" Width="8" Height="8"
                                                 VerticalAlignment="Center" />
                                        <TextBlock x:Name="PeerCountText" FontSize="12"
                                                   AutomationProperties.AccessibilityView="Raw"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource UrTextMutedBrush}" />
                                    </StackPanel>
                                </Button>
                                <!-- discoverability (apple/android parity): whether this device
                                     is itself connectable as a same-network peer -->
                                <TextBlock x:Name="DiscoverableText" Style="{StaticResource UrLabelStyle}" />
                                <!-- out of balance: the action button opens the upgrade flow -->
                                <InfoBar x:Name="BalanceWarning" IsOpen="False" IsClosable="False"
                                         Severity="Warning" />
                                <!-- live stats (macOS parity): providers, throughput, provide -->
                                <TextBlock x:Name="ProviderCountText" Style="{StaticResource UrLabelStyle}" />
                                <TextBlock x:Name="ThroughputText" FontSize="12"
                                           FontFamily="Consolas"
                                           Foreground="{StaticResource UrTextMutedBrush}" />
                                <TextBlock x:Name="ProvideStatsText" Style="{StaticResource UrLabelStyle}" />
                                <!-- Provide control mode: Auto | Always | Network | Never.
                                     "Network" is the private provider (always on, provides
                                     only to same-network peers, never publicly). -->
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0" Spacing="6">
                                    <!-- provide indicator (apple parity): solid dot = Network
                                         provide tier; dot + outer ring = Public tier -->
                                    <Grid Width="14" Height="14" VerticalAlignment="Center">
                                        <Ellipse x:Name="ProvideModeRing" Width="14" Height="14"
                                                 StrokeThickness="1.5" Visibility="Collapsed" />
                                        <Ellipse x:Name="ProvideModeDot" Width="8" Height="8" />
                                    </Grid>
                                    <TextBlock x:Name="ProvideModeLabel" FontSize="12"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource UrTextMutedBrush}" />
                                </StackPanel>
                                <muxc:SelectorBar x:Name="ProvideModeBar"
                                                  SelectionChanged="OnProvideModeChanged">
                                    <muxc:SelectorBarItem x:Name="ProvideAutoItem" />
                                    <muxc:SelectorBarItem x:Name="ProvideAlwaysItem" />
                                    <muxc:SelectorBarItem x:Name="ProvideNetworkItem" />
                                    <muxc:SelectorBarItem x:Name="ProvideNeverItem" />
                                </muxc:SelectorBar>
                                <TextBlock x:Name="ConnectOptionsLabel" FontSize="12" Margin="0,12,0,0"
                                           Foreground="{StaticResource UrTextMutedBrush}" />
                                <!-- Connection Mode: device performance profile -->
                                <muxc:SelectorBar x:Name="ConnectionModeBar"
                                                  SelectionChanged="OnConnectionModeChanged">
                                    <muxc:SelectorBarItem x:Name="ModeAutoItem" />
                                    <muxc:SelectorBarItem x:Name="ModeWebItem" />
                                    <muxc:SelectorBarItem x:Name="ModeStreamingItem" />
                                </muxc:SelectorBar>
                                <Grid>
                                    <TextBlock x:Name="FixedIpLabel" FontSize="14"
                                               VerticalAlignment="Center" />
                                    <ToggleSwitch x:Name="FixedIpToggle"
                                                  Style="{StaticResource UrSwitchToggleStyle}"
                                                  AutomationProperties.LabeledBy="{Binding ElementName=FixedIpLabel}"
                                                  Toggled="OnFixedIpToggled" />
                                </Grid>
                                <Grid>
                                    <TextBlock x:Name="StrongAnonLabel" FontSize="14"
                                               VerticalAlignment="Center" />
                                    <ToggleSwitch x:Name="StrongAnonToggle"
                                                  Style="{StaticResource UrSwitchToggleStyle}"
                                                  AutomationProperties.LabeledBy="{Binding ElementName=StrongAnonLabel}"
                                                  Toggled="OnStrongAnonToggled" />
                                </Grid>
                                <!-- Post quantum encryption: opportunistic e2e; providers
                                     without support fall back to plaintext at this layer -->
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="PostQuantumLabel" FontSize="14"
                                               TextWrapping="Wrap" VerticalAlignment="Center" />
                                    <ToggleSwitch x:Name="PostQuantumToggle" Grid.Column="1"
                                                  Style="{StaticResource UrSwitchToggleStyle}"
                                                  AutomationProperties.LabeledBy="{Binding ElementName=PostQuantumLabel}"
                                                  Toggled="OnPostQuantumToggled" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Card 1: client statistics (remote + blocked charts) -->
                        <Button x:Name="ClientStatsCard" Style="{StaticResource UrCardButtonStyle}"
                                Click="OnClientStatsCardClick">
                            <StackPanel Spacing="12">
                                <Grid>
                                    <TextBlock x:Name="ClientStatsLabel" FontSize="12"
                                               AutomationProperties.AccessibilityView="Raw"
                                               Foreground="{StaticResource UrTextMutedBrush}" />
                                    <FontIcon Glyph="&#xE76C;" FontSize="12"
                                              HorizontalAlignment="Right"
                                              Foreground="{StaticResource UrTextFaintBrush}" />
                                </Grid>
                                <Grid x:Name="RemoteChartHost" Height="128" />
                                <Grid x:Name="BlockedChartHost" Height="128" />
                            </StackPanel>
                        </Button>

                        <!-- Card 2: local statistics (local chart + split rules) -->
                        <Button x:Name="LocalStatsCard" Style="{StaticResource UrCardButtonStyle}"
                                Click="OnLocalStatsCardClick">
                            <StackPanel Spacing="12">
                                <Grid>
                                    <TextBlock x:Name="LocalStatsLabel" FontSize="12"
                                               AutomationProperties.AccessibilityView="Raw"
                                               Foreground="{StaticResource UrTextMutedBrush}" />
                                    <FontIcon Glyph="&#xE76C;" FontSize="12"
                                              HorizontalAlignment="Right"
                                              Foreground="{StaticResource UrTextFaintBrush}" />
                                </Grid>
                                <Grid x:Name="LocalChartHost" Height="128" />
                                <TextBlock x:Name="SplitRuleCountText" FontSize="12" />
                            </StackPanel>
                        </Button>

                        <!-- Card 3: custom dns summary -->
                        <Button x:Name="DnsCard" Style="{StaticResource UrCardButtonStyle}"
                                Click="OnDnsCardClick">
                            <StackPanel Spacing="8">
                                <Grid Margin="0,0,0,4">
                                    <TextBlock x:Name="DnsCardLabel" FontSize="12"
                                               AutomationProperties.AccessibilityView="Raw"
                                               Foreground="{StaticResource UrTextMutedBrush}" />
                                    <FontIcon Glyph="&#xE76C;" FontSize="12"
                                              HorizontalAlignment="Right"
                                              Foreground="{StaticResource UrTextFaintBrush}" />
                                </Grid>
                                <!-- unapplied-recommendation pill (iOS DnsRecommendationPill
                                     parity): shown above the status rows when the applied dns
                                     settings differ from the connected country's regional
                                     recommendation (with a country-color dot) or, failing that,
                                     the safe defaults (no dot); collapsed when they already
                                     match. Driven by MainWindow::ApplyDnsRecommendationPill. -->
                                <Border x:Name="DnsRecPill" Visibility="Collapsed"
                                        Background="{StaticResource UrCoralSubtleBrush}"
                                        CornerRadius="9" Padding="10,5,10,5"
                                        HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal" Spacing="6"
                                                VerticalAlignment="Center">
                                        <Ellipse x:Name="DnsRecDot" Width="8" Height="8"
                                                 VerticalAlignment="Center"
                                                 Visibility="Collapsed" />
                                        <TextBlock x:Name="DnsRecText" FontSize="11"
                                                   FontWeight="Medium" TextWrapping="Wrap"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource UrTextBrush}" />
                                    </StackPanel>
                                </Border>
                                <StackPanel x:Name="DnsRowsPanel" Spacing="8">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse x:Name="DohDot" Width="6" Height="6"
                                                 VerticalAlignment="Center" />
                                        <TextBlock x:Name="DohLabel" Grid.Column="1" FontSize="14" />
                                        <TextBlock x:Name="DohState" Grid.Column="2" FontSize="12" />
                                    </Grid>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse x:Name="UdnsDot" Width="6" Height="6"
                                                 VerticalAlignment="Center" />
                                        <TextBlock x:Name="UdnsLabel" Grid.Column="1" FontSize="14" />
                                        <TextBlock x:Name="UdnsState" Grid.Column="2" FontSize="12" />
                                    </Grid>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse x:Name="LdnsDot" Width="6" Height="6"
                                                 VerticalAlignment="Center" />
                                        <TextBlock x:Name="LdnsLabel" Grid.Column="1" FontSize="14" />
                                        <TextBlock x:Name="LdnsState" Grid.Column="2" FontSize="12" />
                                    </Grid>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse x:Name="FallbackDot" Width="6" Height="6"
                                                 VerticalAlignment="Center" />
                                        <TextBlock x:Name="FallbackLabel" Grid.Column="1" FontSize="14" />
                                        <TextBlock x:Name="FallbackState" Grid.Column="2" FontSize="12" />
                                    </Grid>
                                </StackPanel>
                                <TextBlock x:Name="DnsUnavailableText" FontSize="12"
                                           Visibility="Collapsed"
                                           Foreground="{StaticResource UrTextFaintBrush}" />
                            </StackPanel>
                        </Button>

                        <!-- Block ads and trackers: the device applies and persists it -->
                        <Border x:Name="BlockerCard" Style="{StaticResource UrCardStyle}" Padding="16,8,16,8">
                            <Grid>
                                <TextBlock x:Name="BlockerLabel" FontSize="14"
                                           VerticalAlignment="Center" />
                                <ToggleSwitch x:Name="BlockerToggle"
                                              Style="{StaticResource UrSwitchToggleStyle}"
                                              AutomationProperties.LabeledBy="{Binding ElementName=BlockerLabel}"
                                              Toggled="OnBlockerToggled" />
                            </Grid>
                        </Border>

                        <!-- Plan + usage (macOS ConnectActions.swift:169-204) -->
                        <Border x:Name="DrawerPlanCard" Style="{StaticResource UrCardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock x:Name="DrawerPlanLabel" Style="{StaticResource UrLabelStyle}" />
                                <Grid>
                                    <TextBlock x:Name="DrawerPlanValueText" FontFamily="{StaticResource UrHeadingCondensedFontFamily}" FontSize="22"
                                               FontWeight="SemiBold" />
                                    <StackPanel Orientation="Horizontal" Spacing="8"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <muxc:ProgressRing x:Name="DrawerPlanRing" Width="16" Height="16"
                                                           IsActive="False" Visibility="Collapsed" />
                                        <Button x:Name="DrawerGetProButton" Click="OnOpenUpgrade" />
                                    </StackPanel>
                                </Grid>
                                <Grid x:Name="DrawerUsageBarHost" Height="32" />
                                <StackPanel x:Name="DrawerUsageLegend" Orientation="Horizontal"
                                            Spacing="16" />
                                <Grid Margin="0,4,0,0">
                                    <TextBlock x:Name="DrawerDailyLabel" FontSize="12"
                                               Foreground="{StaticResource UrTextMutedBrush}" />
                                    <TextBlock x:Name="DrawerDailyValue" FontSize="12"
                                               HorizontalAlignment="Right"
                                               Foreground="{StaticResource UrTextMutedBrush}" />
                                </Grid>
                                <Border Height="1" Background="{StaticResource UrBorderBrush}" />
                                <Grid>
                                    <TextBlock x:Name="DrawerReferralTotals" FontSize="12"
                                               Foreground="{StaticResource UrTextMutedBrush}" />
                                    <TextBlock x:Name="DrawerReferralBonus" FontSize="12"
                                               HorizontalAlignment="Right"
                                               Foreground="{StaticResource UrTextMutedBrush}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- Account (macOS AccountRootView parity: plan card + usage bar,
                     redeem, redeemed codes, profile, referrals) -->
                <ScrollViewer x:Name="AccountView" Visibility="Collapsed">
                    <StackPanel Spacing="16" MaxWidth="520" Margin="0,0,0,24">

                        <!-- Plan + usage card -->
                        <Border Style="{StaticResource UrCardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock x:Name="AccountPlanLabel" Style="{StaticResource UrLabelStyle}" />
                                <Grid>
                                    <TextBlock x:Name="AccountPlanValueText" FontFamily="{StaticResource UrHeadingCondensedFontFamily}" FontSize="22"
                                               FontWeight="SemiBold" />
                                    <StackPanel Orientation="Horizontal" Spacing="8"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <muxc:ProgressRing x:Name="AccountPlanRing" Width="16" Height="16"
                                                           IsActive="False" Visibility="Collapsed" />
                                        <Button x:Name="AccountUpgradeButton" Click="OnOpenUpgrade" />
                                    </StackPanel>
                                </Grid>
                                <Grid x:Name="AccountUsageBarHost" Height="32" />
                                <StackPanel x:Name="AccountUsageLegend" Orientation="Horizontal"
                                            Spacing="16" />
                                <Grid Margin="0,4,0,0">
                                    <TextBlock x:Name="AccountDailyLabel" FontSize="12"
                                               Foreground="{StaticResource UrTextMutedBrush}" />
                                    <TextBlock x:Name="AccountDailyValue" FontSize="12"
                                               HorizontalAlignment="Right"
                                               Foreground="{StaticResource UrTextMutedBrush}" />
                                </Grid>
                                <Border Height="1" Background="{StaticResource UrBorderBrush}" />
                                <Grid>
                                    <TextBlock x:Name="AccountReferralTotals" FontSize="12"
                                               Foreground="{StaticResource UrTextMutedBrush}" />
                                    <TextBlock x:Name="AccountReferralBonus" FontSize="12"
                                               HorizontalAlignment="Right"
                                               Foreground="{StaticResource UrTextMutedBrush}" />
                                </Grid>
                                <!-- full-width redeem row (macOS: its own tappable row) -->
                                <Button x:Name="RedeemRowButton" HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Background="Transparent" BorderThickness="0"
                                        Padding="0,8,0,8" Click="OnOpenRedeem">
                                    <Grid HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="RedeemRowText" FontSize="14" />
                                        <FontIcon Grid.Column="1" Glyph="&#xE76C;" FontSize="12"
                                                  Foreground="{StaticResource UrTextMutedBrush}" />
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Redeemed balance codes -->
                        <Border Style="{StaticResource UrCardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock x:Name="BalanceCodesLabel" Style="{StaticResource UrLabelStyle}" />
                                <!-- header + rows built in code (LoadBalanceCodes) -->
                                <StackPanel x:Name="BalanceCodesPanel" Spacing="6" />
                                <TextBlock x:Name="BalanceCodesEmptyText" FontSize="12"
                                           Visibility="Collapsed"
                                           Foreground="{StaticResource UrTextFaintBrush}" />
                            </StackPanel>
                        </Border>

                        <!-- Profile -->
                        <Border Style="{StaticResource UrCardStyle}">
                            <StackPanel Spacing="12">
                                <TextBlock x:Name="AccountHeading" FontFamily="{StaticResource UrHeadingFontFamily}" FontSize="18" FontWeight="SemiBold" />
                                <TextBox x:Name="NetworkNameBox" />
                                <Button x:Name="SaveNameButton" Click="OnSaveNetworkName" />
                                <TextBlock x:Name="AccountAuthText"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <!-- name-availability line, change password, auth
                                     methods (AccountPage::BuildProfileExtra) -->
                                <StackPanel x:Name="AccountProfileExtra" Spacing="8" />
                            </StackPanel>
                        </Border>

                        <!-- Referrals -->
                        <Border Style="{StaticResource UrCardStyle}">
                            <StackPanel Spacing="12">
                                <TextBlock x:Name="ReferralsHeading" FontFamily="{StaticResource UrHeadingFontFamily}" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock x:Name="ReferralText" TextWrapping="Wrap" />

                                <!-- referral royalty: networks with at least one referral get
                                     the crowned frog mascot (same as the ur.io site) -->
                                <StackPanel x:Name="RoyaltyBadge" Visibility="Collapsed"
                                            HorizontalAlignment="Center" Spacing="4">
                                    <Image Source="ms-appx:///Assets/ReferralFrog.png"
                                           Width="80" Height="80" />
                                    <TextBlock x:Name="RoyaltyText" HorizontalAlignment="Center"
                                               Foreground="{StaticResource UrTextMutedBrush}" FontSize="12" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Wallet -->
                <ScrollViewer x:Name="WalletView" Visibility="Collapsed">
                    <StackPanel Spacing="12" MaxWidth="520">
                        <TextBlock x:Name="PlanHeading" FontFamily="{StaticResource UrHeadingFontFamily}" FontSize="18" FontWeight="SemiBold" />
                        <Button x:Name="UpgradeButton"
                                Style="{StaticResource AccentButtonStyle}" Click="OnOpenUpgrade" />
                        <muxc:InfoBar x:Name="WalletInfo" Style="{StaticResource UrSnackbarStyle}" IsOpen="False" />
                        <TextBlock x:Name="PayoutWalletsHeading" FontFamily="{StaticResource UrHeadingFontFamily}" FontSize="16" FontWeight="SemiBold"
                                   Margin="0,12,0,0" />
                        <ListView x:Name="WalletsList" MaxHeight="200" BorderThickness="1"
                                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" />

                        <!-- Connect an external wallet by address. The server
                             validates it per chain; Bittensor (TAO) wallets are
                             recorded for future use only and can never be the
                             payout wallet. -->
                        <TextBlock x:Name="ConnectWalletHeading" FontFamily="{StaticResource UrHeadingFontFamily}" FontSize="16" FontWeight="SemiBold"
                                   Margin="0,12,0,0" />
                        <TextBlock x:Name="ConnectWalletChainsText" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{StaticResource UrTextMutedBrush}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="WalletAddressBox" Grid.Column="0"
                                     TextChanged="OnWalletAddressChanged" />
                            <Button x:Name="ConnectWalletButton" Grid.Column="1"
                                    IsEnabled="False" Click="OnConnectWallet" />
                        </Grid>
                        <TextBlock x:Name="WalletChainText" FontSize="12"
                                   Foreground="{StaticResource UrTextMutedBrush}" />
                    </StackPanel>
                </ScrollViewer>

                <!-- Leaderboard -->
                <ScrollViewer x:Name="LeaderboardView" Visibility="Collapsed">
                    <StackPanel Spacing="8" MaxWidth="640">
                        <!-- No section heading here: NavigationView's Header already
                             shows the destination name ("Leaderboard"), and a panel
                             heading with the same word under it read as a stutter.
                             The other destinations keep theirs because their headings
                             name a SECTION ("Plan", "Feedback"), not the destination. -->
                        <TextBlock x:Name="LeaderboardDescription"
                                   Style="{StaticResource UrSupportingTextStyle}" />
                        <!-- Loading / empty / failed. Without it the panel drew one
                             heading and nothing else whether the fetch was in
                             flight, had returned nothing, or had failed - three
                             very different situations, one blank screen. -->
                        <TextBlock x:Name="LeaderboardStatusText"
                                   Style="{StaticResource UrSupportingTextStyle}" />
                        <ListView x:Name="LeaderboardList" />
                    </StackPanel>
                </ScrollViewer>

                <!-- Support -->
                <ScrollViewer x:Name="SupportView" Visibility="Collapsed">
                    <StackPanel Spacing="12" MaxWidth="520">
                        <TextBlock x:Name="FeedbackHeading" FontFamily="{StaticResource UrHeadingFontFamily}" FontSize="18" FontWeight="SemiBold" />
                        <muxc:RatingControl x:Name="FeedbackRating" />
                        <TextBox x:Name="FeedbackText" AcceptsReturn="True" TextWrapping="Wrap"
                                 MinHeight="80" />
                        <!-- apple FeedbackView: logs go to the server ONLY from
                             here, only when this is ticked, and only with the
                             server-issued feedback id (SettingsPage). -->
                        <CheckBox x:Name="FeedbackIncludeLogs" />
                        <Button x:Name="SendFeedbackButton" Click="OnSendFeedback" />
                        <muxc:InfoBar x:Name="SupportInfo" Style="{StaticResource UrSnackbarStyle}" IsOpen="False" />
                    </StackPanel>
                </ScrollViewer>

                <!-- Settings -->
                <ScrollViewer x:Name="SettingsView" Visibility="Collapsed">
                    <StackPanel Spacing="16" MaxWidth="520">
                        <!-- Every section above the split rules is built in code
                             (SettingsPage::BuildSections): connection, device,
                             account, blocked locations, identity, preferences,
                             logs, links. -->
                        <StackPanel x:Name="SettingsSections" Spacing="16" />
                        <TextBlock x:Name="SplitTunnelHeading" FontFamily="{StaticResource UrHeadingFontFamily}" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock x:Name="SplitTunnelDescription"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button x:Name="ManageAppSplitButton" Click="OnManageAppSplitTunnel"
                                Style="{StaticResource AccentButtonStyle}" />
                        <TextBlock x:Name="SettingsAccountHeading" FontFamily="{StaticResource UrHeadingFontFamily}" FontSize="18" FontWeight="SemiBold"
                                   Margin="0,16,0,0" />
                        <Button x:Name="SignOutButton" Click="OnSignOut" />
                        <!-- delete account (SettingsPage::BuildDangerSection) -->
                        <StackPanel x:Name="SettingsDangerSection" Spacing="8" />
                        <HyperlinkButton x:Name="ProtocolLink" NavigateUri="https://ur.xyz"
                                         FontSize="12" Padding="0" Margin="0,16,0,0" />
                    </StackPanel>
                </ScrollViewer>

                <!-- Developer / reliability (P2). Empty on purpose: the ~40
                     controls are built by urnw::DeveloperPage in code, which
                     keeps this shared file to one host element. -->
                <ScrollViewer x:Name="DeveloperView" Visibility="Collapsed"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto" />
            </Grid>
        </muxc:NavigationView>

        <!-- The standing reason this app is not carrying traffic (rpc-only, or
             a session that could not be started). Driven by DeveloperPage from
             SdkHost::SetModeNoticeHandler. Window level, not page level: it is
             true whichever destination is on screen. IsClosable is set in code
             and is never true - this is a property of the session, not an
             event, and it stays until it is replaced. -->
        <muxc:InfoBar x:Name="ModeNoticeBar" Grid.Row="2" IsOpen="False"
                      IsClosable="False" Margin="12,0,12,12"
                      FontFamily="{StaticResource UrBodyFontFamily}" />
    </Grid>
</Window>
