<?xml version="1.0" encoding="utf-8"?>
<!-- URnetwork main window. Sign-in flow (initial → password / create / verify /
     reset — macOS Authenticate/** parity), then a NavigationView home with the
     macOS sections: Connect, Account, Wallet, Leaderboard, Support, Settings.
     Each home panel is driven by MainWindow code-behind over the SDK Api.

     No user-facing text lives in this file: every label is named and set from the
     shared localization store in MainWindow::ApplyStrings (Localization.h). Tags
     ("connect", "phantom", ...) are internal identifiers, not UI text.
     SPDX-License-Identifier: MPL-2.0 -->
<Window
    x:Class="URnetwork.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <Grid Background="{StaticResource UrBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <!-- Row 2 carries the persistent session-mode notice (P2). Appended
                 rather than inserted so no existing element's Grid.Row moves:
                 four phases share this file. -->
            <RowDefinition Height="Auto" />
            <!-- Row 3: the persistent status strip (D4). Appended for the same
                 reason, and it is the LAST row on purpose - Proton pins theirs
                 to the bottom edge of the window, under everything including
                 the standing mode notice, because it is the least urgent and
                 the most permanent thing on screen. -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The title bar. ExtendsContentIntoTitleBar puts the window's content
             under the system caption buttons; SetTitleBar(AppTitleBar) is what
             makes this strip the DRAG region, which is the difference between a
             wordmark drawn where a title bar would be and an actual title bar.
             Height 40 leaves the caption buttons (32 tall, drawn by the system
             at the top right) clear of the wordmark's descenders.

             The wordmark itself: android sets its top-bar title in PP NeueBit
             Bold at 24sp (Type.kt TopBarTitleTextStyle). The file carries only a
             Bold face, so the weight is stated rather than left to be
             synthesised. -->
        <!-- R1: the integrated title bar is 48epx per the spec (was 40). Left
             content is a 20epx app icon and the PP NeueBit wordmark; the whole
             strip is the SetTitleBar drag region. IsHitTestVisible=False on the
             content so the drag region is not swallowed by the icon or the text. -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="48" Background="Transparent">
            <StackPanel Orientation="Horizontal" Margin="16,0" Spacing="8"
                        VerticalAlignment="Center" IsHitTestVisible="False">
                <Image x:Name="BrandIcon" Width="20" Height="20"
                       VerticalAlignment="Center"
                       Source="ms-appx:///Assets/app.ico" />
                <TextBlock x:Name="BrandText" VerticalAlignment="Center"
                           FontFamily="{StaticResource UrWordmarkFontFamily}"
                           FontSize="24" FontWeight="Bold" />
            </StackPanel>
        </Grid>

        <!-- The account menu (iOS Shared/Views/AccountMenu.swift): the avatar in
             the top bar, opening network name / create account (guests) / sign
             out / share URnetwork.

             It is a SIBLING of AppTitleBar, not a child, and that is
             load-bearing. SetTitleBar(AppTitleBar) makes that element the drag
             region, and a drag region swallows pointer input from everything
             inside it - a button parented there simply never fires. Sitting in
             the same Grid row beside it keeps the layout and keeps the clicks.
             The right margin clears the system caption buttons. -->
        <Button x:Name="AccountMenuButton" Grid.Row="0" Visibility="Collapsed"
                HorizontalAlignment="Right" VerticalAlignment="Center"
                Margin="0,0,150,0" Padding="2" Width="32" Height="32"
                CornerRadius="16" Background="Transparent" BorderThickness="0"
                Click="OnAccountMenu">
            <Grid>
                <!-- Pro gold ring. Android and iOS spend this colour on the Pro
                     entitlement and on nothing else, so a gold ring here reads
                     as "this account is Pro" rather than as decoration. -->
                <Ellipse x:Name="AccountProRing" Width="30" Height="30"
                         StrokeThickness="2" Visibility="Collapsed" />
                <muxc:PersonPicture x:Name="AccountAvatar" Width="26" Height="26" />
            </Grid>
        </Button>

        <!-- Sign-in flow: one step visible at a time (ShowLoginStep).
             FontFamily here is the BODY face for everything inside: font
             properties inherit down the XAML tree, so the bare TextBlocks in
             these panels pick it up without being touched one by one. The
             headings below override it, and templated controls take it from
             ContentControlThemeFontFamily instead (a style setter beats an
             inherited value). -->
        <ScrollViewer x:Name="LoginRoot" Grid.Row="1"
                      FontFamily="{StaticResource UrBodyFontFamily}"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <Grid>

                <!-- Initial: THE LOGIN STACK RULE, shared by every app (ur.io
                     ConnectDialog is the reference): up to three full-width
                     sign-in pills, then the remaining ways in as small square
                     icon tiles, four per row with each row filled and the rows
                     exactly as wide as the pills, then the "or" divider and the
                     email / phone field. Windows offers Google, Apple and Create
                     Instant Account as the pills and Secret key, Auth code,
                     Bittensor and Solana as the tiles; nothing else is in the
                     stack. The column is widthIn(max = 512.dp) inside a centred
                     Row, as on android.

                     There is deliberately NO "Sign in" heading here: android has none
                     on the initial screen, the carousel above supplies the headline.
                     There is also no guest-mode button - it does not exist in the
                     android login, and guest mode is superseded by the seedphrase
                     system. -->
                <StackPanel x:Name="LoginPanel" Margin="16" Spacing="12"
                            MaxWidth="512" HorizontalAlignment="Stretch"
                            VerticalAlignment="Center">

                    <!-- The carousel (iOS LoginCarousel). Three brand images
                         crossfading inside the ur globe silhouette, with the
                         headline that belongs to each sliding through. This is
                         what the comment above means by "the carousel above
                         supplies the headline": without it the top third of the
                         signed-out screen was empty and the screen carried no
                         heading at all. Built and animated from code
                         (LoginCarousel.cpp); this is only its slot.

                         MaxHeight, not Height, and driven from code
                         (LoginPage::ApplyLoginLayout). At 200 fixed it pushed
                         Sign in with Seedphrase, Create Instant Account and
                         Change Network API - the three affordances the owner
                         asked for by name - off the bottom of the window, at
                         every size from the ~480x760 default up. The hero may
                         not cost the screen its purpose: it takes the space
                         that is left over and shrinks, to zero if it must. -->
                    <Grid x:Name="LoginCarouselHost" Height="200" MinHeight="0"
                          Margin="0,0,0,4" />

                    <!-- Sign in with Google, through the ur.io SSO BRIDGE in the
                         default browser (SdkHost::SignInWithSso): the bridge runs
                         the same Google flow the ur.io login dialog runs and hands
                         the identity token back on urnetwork://sso. No OAuth client
                         has to be compiled in, so the pill is always offered - the
                         loopback flow that used to gate it is gone. -->
                    <Button x:Name="GoogleSignInButton"
                            Style="{StaticResource UrSecondaryButtonStyle}"
                            Click="OnSignInWithGoogle">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <!-- the Google "G", drawn in its four brand colours;
                                 the mark may not be recoloured -->
                            <Viewbox Width="18" Height="18" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="#4285F4" Data="M23.49,12.27C23.49,11.48 23.42,10.73 23.3,10H12V14.51H18.47C18.18,15.99 17.33,17.24 16.07,18.09V21.09H19.93C22.19,19 23.49,15.92 23.49,12.27Z" />
                                    <Path Fill="#34A853" Data="M12,24C15.24,24 17.95,22.92 19.93,21.09L16.07,18.09C14.99,18.81 13.62,19.25 12,19.25C8.87,19.25 6.22,17.14 5.27,14.29H1.29V17.38C3.26,21.3 7.31,24 12,24Z" />
                                    <Path Fill="#FBBC05" Data="M5.27,14.29C5.02,13.57 4.89,12.8 4.89,12C4.89,11.2 5.03,10.43 5.27,9.71V6.62H1.29C0.47,8.24 0,10.06 0,12C0,13.94 0.47,15.76 1.29,17.38L5.27,14.29Z" />
                                    <Path Fill="#EA4335" Data="M12,4.75C13.77,4.75 15.35,5.36 16.6,6.55L20.02,3.13C17.95,1.19 15.24,0 12,0C7.31,0 3.26,2.7 1.29,6.62L5.27,9.71C6.22,6.86 8.87,4.75 12,4.75Z" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock x:Name="GoogleSignInText" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Sign in with Apple, through the same bridge (Apple JS on
                         ur.io); the mark is the one the ur.io dialog draws. -->
                    <Button x:Name="AppleSignInButton"
                            Style="{StaticResource UrSecondaryButtonStyle}"
                            Click="OnSignInWithApple">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="Black" Data="M18.71,19.5c-0.83,1.24 -1.71,2.45 -3.05,2.47c-1.34,0.03 -1.77,-0.79 -3.29,-0.79c-1.53,0 -2,0.77 -3.27,0.82c-1.31,0.05 -2.3,-1.32 -3.14,-2.53C4.25,17 2.94,12.45 4.7,9.39c0.87,-1.52 2.43,-2.48 4.12,-2.51c1.28,-0.02 2.5,0.87 3.29,0.87c0.78,0 2.26,-1.07 3.8,-0.91c0.65,0.03 2.47,0.26 3.64,1.98c-0.09,0.06 -2.17,1.28 -2.15,3.81c0.03,3.02 2.65,4.03 2.68,4.04c-0.03,0.07 -0.42,1.44 -1.38,2.83M13,3.5c0.73,-0.83 1.94,-1.46 2.94,-1.5c0.13,1.17 -0.34,2.35 -1.04,3.19c-0.69,0.85 -1.83,1.51 -2.95,1.42c-0.15,-1.15 0.41,-2.35 1.05,-3.11z" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock x:Name="AppleSignInText" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Create Instant Account: mints a seedphrase-only network
                         (macOS CreateNetworkInstant). The third and last pill. -->
                    <Button x:Name="InstantAccountButton"
                            Style="{StaticResource UrSecondaryButtonStyle}"
                            Click="OnCreateInstantAccount" />

                    <!-- The tiles. Four star columns share the row exactly, so the
                         four tiles fill it edge to edge under the pills; a fifth
                         would start a second row of the same grid. Each is an icon
                         over a short caption; the UIA name is the full sentence
                         (LoginPage::ApplySignInAutomationNames). -->
                    <Grid x:Name="LoginTileRow" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Secret key: sign in with an instant account's seedphrase
                             (macOS LoginSeedphrase). Segoe Fluent "Permissions" key. -->
                        <Button x:Name="SeedphraseSignInButton" Grid.Column="0"
                                Style="{StaticResource UrTileButtonStyle}"
                                Click="OnSignInWithSeedphrase">
                            <StackPanel Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE8D7;" FontSize="22" HorizontalAlignment="Center" />
                                <TextBlock x:Name="SeedphraseTileText" Style="{StaticResource UrTileCaptionStyle}" />
                            </StackPanel>
                        </Button>

                        <!-- Auth code: android opens AuthCodeLoginSheet rather than
                             showing an inline field; the desktop equivalent is a
                             dialog (OnUseCode). -->
                        <Button x:Name="AuthCodeButton" Grid.Column="1"
                                Style="{StaticResource UrTileButtonStyle}"
                                Click="OnUseCode">
                            <StackPanel Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Viewbox Width="22" Height="22" HorizontalAlignment="Center">
                                    <Canvas Width="32" Height="32">
                                        <Path Fill="Black" Data="M30.48,10.67H32v10.66h-1.52Z M28.95,21.33h1.53v1.53h-1.53Z M28.95,9.14h1.53v1.53h-1.53Z M3.05,22.86h25.9v1.52H3.05Z M21.34,16.76h7.61v1.52h-7.61Z M18.29,16.76h1.52v1.52h-1.52Z M3.05,7.62h25.9v1.52H3.05Z M1.52,9.14h1.53v1.53H1.52Z M1.52,21.33h1.53v1.53H1.52Z M0,10.67h1.52v10.66H0Z M6.1,12.19h1.52v7.62H6.1Z M9.14,12.19h1.53v7.62H9.14Z M12.19,12.19h1.52v7.62h-1.52Z M16.76,12.19h1.53v7.62h-1.53Z M21.34,12.19h1.52v7.62h-1.52Z M25.9,12.19h1.53v7.62H25.9Z" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock x:Name="AuthCodeButtonText" Style="{StaticResource UrTileCaptionStyle}" />
                            </StackPanel>
                        </Button>

                        <!-- Wallet sign in through the ur.io/wallet-connect browser
                             bridge (desktop wallets are browser extensions, not
                             deeplink apps). -->
                        <Button x:Name="BittensorSignInButton" Grid.Column="2"
                                Style="{StaticResource UrTileButtonStyle}"
                                Click="OnSignInWithBittensor">
                            <StackPanel Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <!-- android res/drawable/bittensor_logo.xml, converted by
                                     tools/vd2xaml. Upstream its fillColor is #FFFFFFFF,
                                     which is invisible on the white SECONDARY button it
                                     sits on over there; drawn here in the button's content
                                     colour so it can actually be seen. -->
                                <Viewbox Width="22" Height="22" HorizontalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="Black" Data="M6,7 L18,7 L18,9.2 L13.3,9.2 L13.3,13.9 C13.3,15.02 13.94,15.6 15.1,15.6 L15.7,15.6 L15.7,17 L14.7,17 C12.35,17 10.9,15.82 10.9,13.9 L10.9,9.2 L6,9.2 Z" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock x:Name="BittensorSignInText" Style="{StaticResource UrTileCaptionStyle}" />
                            </StackPanel>
                        </Button>

                        <!-- ONE Solana tile, as android has one button. The bridge
                             needs a provider up front, so this presents a wallet
                             chooser - the desktop analogue of android's Mobile
                             Wallet Adapter picker. -->
                        <Button x:Name="SolanaSignInButton" Grid.Column="3"
                                Style="{StaticResource UrTileButtonStyle}"
                                Click="OnSignInWithSolana">
                            <StackPanel Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Viewbox Width="22" Height="22" HorizontalAlignment="Center">
                                    <Canvas Width="101" Height="88">
                                        <Path Data="M100.48,69.38L83.81,86.8C83.44,87.18 83.01,87.48 82.52,87.69C82.03,87.89 81.51,88 80.97,88H1.94C1.56,88 1.19,87.89 0.87,87.69C0.56,87.49 0.31,87.2 0.16,86.87C0.01,86.53 -0.04,86.16 0.03,85.79C0.09,85.43 0.26,85.1 0.52,84.83L17.21,67.41C17.57,67.03 18,66.73 18.49,66.52C18.98,66.32 19.5,66.21 20.03,66.21H99.06C99.44,66.21 99.81,66.32 100.13,66.52C100.44,66.72 100.69,67.01 100.84,67.34C100.99,67.68 101.04,68.05 100.97,68.42C100.91,68.78 100.74,69.11 100.48,69.38ZM83.81,34.3C83.44,33.92 83.01,33.62 82.52,33.42C82.03,33.21 81.51,33.1 80.97,33.1H1.94C1.56,33.1 1.19,33.21 0.87,33.41C0.56,33.62 0.31,33.9 0.16,34.24C0.01,34.58 -0.04,34.95 0.03,35.31C0.09,35.67 0.26,36.01 0.52,36.28L17.21,53.7C17.57,54.07 18,54.38 18.49,54.58C18.98,54.79 19.5,54.89 20.03,54.9H99.06C99.44,54.9 99.81,54.79 100.13,54.59C100.44,54.38 100.69,54.1 100.84,53.76C100.99,53.42 101.04,53.05 100.97,52.69C100.91,52.33 100.74,51.99 100.48,51.72L83.81,34.3ZM1.94,21.79H80.97C81.51,21.79 82.03,21.68 82.52,21.48C83.01,21.27 83.44,20.97 83.81,20.59L100.48,3.17C100.74,2.9 100.91,2.57 100.97,2.21C101.04,1.84 100.99,1.47 100.84,1.13C100.69,0.8 100.44,0.51 100.13,0.31C99.81,0.11 99.44,0 99.06,0L20.03,0C19.5,0 18.98,0.11 18.49,0.31C18,0.52 17.57,0.82 17.21,1.2L0.52,18.62C0.27,18.89 0.1,19.22 0.03,19.58C-0.03,19.95 0.01,20.32 0.16,20.65C0.31,20.99 0.56,21.28 0.88,21.48C1.19,21.68 1.56,21.79 1.94,21.79Z">
                                            <Path.Fill>
                                                <LinearGradientBrush MappingMode="Absolute" StartPoint="8.53,90.1" EndPoint="88.99,-3.02">
                                                    <GradientStop Offset="0.08" Color="#FF9945FF" />
                                                    <GradientStop Offset="0.3" Color="#FF8752F3" />
                                                    <GradientStop Offset="0.5" Color="#FF5497D5" />
                                                    <GradientStop Offset="0.6" Color="#FF43B4CA" />
                                                    <GradientStop Offset="0.72" Color="#FF28E0B9" />
                                                    <GradientStop Offset="0.97" Color="#FF19FB9B" />
                                                </LinearGradientBrush>
                                            </Path.Fill>
                                        </Path>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock x:Name="SolanaSignInText" Style="{StaticResource UrTileCaptionStyle}" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <TextBlock x:Name="OrDivider" HorizontalAlignment="Center"
                               FontFamily="{StaticResource UrBodyFontFamily}"
                               Foreground="{StaticResource UrTextMutedBrush}" />

                    <!-- URTextInput: label, then the underlined field. Spacing is 0
                         here because the label style carries android's 8dp gap and
                         the field owns the padding above its underline. -->
                    <StackPanel Spacing="0">
                        <TextBlock x:Name="EmailLabel" Style="{StaticResource UrTextInputLabelStyle}" />
                        <TextBox x:Name="EmailBox" Style="{StaticResource UrTextInputStyle}"
                                 TextChanged="OnUserAuthChanged" />
                    </StackPanel>

                    <!-- Disabled until the field has something in it, as on iOS
                         and android: an enabled primary button over an empty
                         field promises an action that cannot happen. -->
                    <Button x:Name="GetStartedButton" IsEnabled="False"
                            Style="{StaticResource UrPrimaryButtonStyle}"
                            Click="OnGetStarted" />

                    <!-- URInlineErrorText, not an InfoBar -->
                    <TextBlock x:Name="LoginErrorText"
                               Style="{StaticResource UrInlineErrorTextStyle}"
                               Visibility="Collapsed" />

                    <!-- "Change Network API" (iOS NetworkServerSheet) - the very
                         last thing on the screen, bottom LEFT, small and muted,
                         and reading as PLAIN TEXT rather than another pill: it
                         is a developer/fork affordance, not a sign-in option,
                         and a sixth white pill would read as one. Left edge
                         lines up with the "Email or phone number" label above.

                         A HyperlinkButton, NOT a TextBlock with a Tapped
                         handler. It looks the same either way, but a TextBlock
                         is not focusable, never reaches the tab order and is
                         announced as static text - the UIA tree showed this
                         affordance as plain "Text" with no invoke pattern, i.e.
                         unreachable without a mouse. The styling below (no
                         padding, muted foreground, body face) is what makes a
                         real control render as quiet text. -->
                    <HyperlinkButton x:Name="NetworkServerLink" HorizontalAlignment="Left"
                                     FontSize="12" Margin="0,8,0,0" Padding="0"
                                     Background="Transparent" BorderThickness="0"
                                     FontFamily="{StaticResource UrBodyFontFamily}"
                                     Foreground="{StaticResource UrTextMutedBrush}"
                                     Click="OnChangeNetworkServer" />
                </StackPanel>

                <!-- Password: an existing account signs in -->
                <StackPanel x:Name="PasswordPanel" Margin="24" Spacing="12"
                            MaxWidth="420" VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <Button x:Name="PasswordBackButton" Tag="initial" Click="OnLoginBack" />
                    <!-- the step's fields on a card. Every sign-in step was a bare
                         column floating on the page: at 1000px tall the seedphrase
                         step was ~330px of black, a 400px-wide run of controls, and
                         ~300px more black, with nothing saying where the form began
                         or ended. -->
                    <Border Style="{StaticResource UrCardStyle}" Padding="24">
                        <StackPanel Spacing="12">
                        <TextBlock x:Name="PasswordHeading" FontFamily="{StaticResource UrHeadingFontFamily}" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock x:Name="PasswordEmailText"
                                   Foreground="{StaticResource UrTextMutedBrush}" />
                        <PasswordBox x:Name="PasswordBox" Style="{StaticResource UrPasswordInputStyle}"
                                     KeyDown="OnPasswordKeyDown" />
                        <Button x:Name="SignInButton"
                                Style="{StaticResource AccentButtonStyle}"
                                HorizontalAlignment="Stretch" Click="OnSignIn" />
                        <muxc:InfoBar x:Name="PasswordError" Severity="Error" IsOpen="False" IsClosable="False" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock x:Name="ForgotPasswordLabel" Style="{StaticResource UrLabelStyle}"
                                       VerticalAlignment="Center" />
                            <Button x:Name="ForgotResetButton" FontSize="12" Padding="4,2"
                                    Background="Transparent" BorderThickness="0"
                                    Click="OnForgotPassword" />
                        </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Create network: sign-up (email + password), a wallet that
                     isn't linked to a network yet (name + terms only), or the
                     guest network's upgrade to a full account (editable email;
                     MainWindow::EnterCreateStep drives the per-mode visibility) -->
                <StackPanel x:Name="CreatePanel" Margin="24" Spacing="12"
                            MaxWidth="420" VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <Button x:Name="CreateBackButton" Tag="initial" Click="OnLoginBack" />
                    <!-- the step's fields on a card. Every sign-in step was a bare
                         column floating on the page: at 1000px tall the seedphrase
                         step was ~330px of black, a 400px-wide run of controls, and
                         ~300px more black, with nothing saying where the form began
                         or ended. -->
                    <Border Style="{StaticResource UrCardStyle}" Padding="24">
                        <StackPanel Spacing="12">
                        <TextBlock x:Name="CreateHeading" FontFamily="{StaticResource UrHeadingFontFamily}" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock x:Name="WalletCreateNote" Style="{StaticResource UrSupportingTextStyle}"
                                   Visibility="Collapsed"
                                   />
                        <!-- guest upgrade (the plan card's create-account affordance):
                             status + call to action, and an editable email in place of
                             the echoed one -->
                        <TextBlock x:Name="GuestUpgradeNote" Style="{StaticResource UrSupportingTextStyle}"
                                   Visibility="Collapsed"
                                   />
                        <TextBlock x:Name="CreateEmailText"
                                   Foreground="{StaticResource UrTextMutedBrush}" />
                        <TextBox x:Name="CreateEmailBox" Style="{StaticResource UrTextInputStyle}"
                                 Visibility="Collapsed" TextChanged="OnCreateEmailChanged" />
                        <TextBox x:Name="CreateNameBox" Style="{StaticResource UrTextInputStyle}"
                                 TextChanged="OnCreateNameChanged" />
                        <TextBlock x:Name="CreateNameStatusText" Style="{StaticResource UrSupportingTextStyle}"
                                   />
                        <PasswordBox x:Name="CreatePasswordBox" Style="{StaticResource UrPasswordInputStyle}"
                                     PasswordChanged="OnCreatePasswordChanged" />
                        <TextBlock x:Name="CreatePasswordHint" Style="{StaticResource UrSupportingTextStyle}"
                                   />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="TermsCheck" MinWidth="0" VerticalAlignment="Top"
                                      AutomationProperties.LabeledBy="{Binding ElementName=TermsText}"
                                      Checked="OnTermsChanged" Unchecked="OnTermsChanged" />
                            <!-- inlines with tappable terms/privacy links, set in code -->
                            <TextBlock x:Name="TermsText" Grid.Column="1" TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource UrTextMutedBrush}" />
                        </Grid>
                        <TextBox x:Name="BonusCodeBox" Style="{StaticResource UrTextInputStyle}"
                                 TextChanged="OnBonusCodeChanged" />
                        <TextBlock x:Name="BonusStatusText" Style="{StaticResource UrSupportingTextStyle}"
                                   />
                        <!-- referral accepted: the gold king-frog chip (replaces the
                             supporting line while the code is valid) -->
                        <StackPanel x:Name="BonusAppliedChip" Orientation="Horizontal"
                                    Spacing="8" Visibility="Collapsed"
                                    HorizontalAlignment="Left" Padding="12,6"
                                    CornerRadius="16"
                                    BorderBrush="{StaticResource UrReferralGoldBrush}"
                                    BorderThickness="1">
                            <Image Source="ms-appx:///Assets/ReferralFrog.png"
                                   Width="20" Height="20"
                                   AutomationProperties.AccessibilityView="Raw" />
                            <TextBlock x:Name="BonusAppliedText" VerticalAlignment="Center"
                                       Style="{StaticResource UrCaptionTextStyle}"
                                       Foreground="{StaticResource UrReferralGoldLightBrush}" />
                        </StackPanel>
                        <Button x:Name="CreateButton" IsEnabled="False"
                                Style="{StaticResource AccentButtonStyle}"
                                HorizontalAlignment="Stretch" Click="OnCreateNetwork" />
                        <muxc:InfoBar x:Name="CreateError" Severity="Error" IsOpen="False" IsClosable="False" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Verify: the emailed / texted one-time code -->
                <StackPanel x:Name="VerifyPanel" Margin="24" Spacing="12"
                            MaxWidth="420" VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <Button x:Name="VerifyBackButton" Tag="initial" Click="OnLoginBack" />
                    <!-- the step's fields on a card. Every sign-in step was a bare
                         column floating on the page: at 1000px tall the seedphrase
                         step was ~330px of black, a 400px-wide run of controls, and
                         ~300px more black, with nothing saying where the form began
                         or ended. -->
                    <Border Style="{StaticResource UrCardStyle}" Padding="24">
                        <StackPanel Spacing="12">
                        <TextBlock x:Name="VerifyHeading" FontFamily="{StaticResource UrHeadingFontFamily}" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock x:Name="VerifyExplanationText" TextWrapping="Wrap"
                                   Foreground="{StaticResource UrTextMutedBrush}" />
                        <TextBox x:Name="VerifyCodeBox" Style="{StaticResource UrTextInputStyle}"
                                 MaxLength="6" TextChanged="OnVerifyCodeChanged" />
                        <Button x:Name="VerifyButton" IsEnabled="False"
                                Style="{StaticResource AccentButtonStyle}"
                                HorizontalAlignment="Stretch" Click="OnVerifySubmit" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock x:Name="DontSeeItLabel" Style="{StaticResource UrLabelStyle}"
                                       VerticalAlignment="Center" />
                            <Button x:Name="ResendCodeButton" FontSize="12" Padding="4,2"
                                    Background="Transparent" BorderThickness="0"
                                    Click="OnResendCode" />
                        </StackPanel>
                        <muxc:InfoBar x:Name="VerifyInfo" IsOpen="False" IsClosable="False" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Seedphrase: sign in with a 12- or 24-word phrase (macOS
                     LoginSeedphraseView). The field is a multi-line monospace
                     box because a 24-word phrase does not fit on one line and
                     people paste it with newlines in it.

                     IsSpellCheckEnabled / IsTextPredictionEnabled are OFF on
                     purpose: autocorrect on a BIP-39 word list silently
                     rewrites the credential, and a prediction service would be
                     handed a live seedphrase. -->
                <StackPanel x:Name="SeedphrasePanel" Margin="24" Spacing="12"
                            MaxWidth="440" VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <Button x:Name="SeedphraseBackButton" Tag="initial" Click="OnLoginBack" />
                    <!-- the step's fields on a card. Every sign-in step was a bare
                         column floating on the page: at 1000px tall the seedphrase
                         step was ~330px of black, a 400px-wide run of controls, and
                         ~300px more black, with nothing saying where the form began
                         or ended. -->
                    <Border Style="{StaticResource UrCardStyle}" Padding="24">
                        <StackPanel Spacing="12">
                        <TextBlock x:Name="SeedphraseHeading" FontFamily="{StaticResource UrHeadingFontFamily}" FontSize="20" FontWeight="SemiBold" />
                        <TextBox x:Name="SeedphraseBox" Style="{StaticResource UrTextInputStyle}"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120"
                                 FontFamily="Consolas"
                                 IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"
                                 TextChanged="OnSeedphraseChanged" />
                        <TextBlock x:Name="SeedphraseWordCountText"
                                   Style="{StaticResource UrSupportingTextStyle}"
                                   TextWrapping="Wrap" />
                        <Button x:Name="SeedphraseSubmitButton" IsEnabled="False"
                                Style="{StaticResource AccentButtonStyle}"
                                HorizontalAlignment="Stretch" Click="OnSeedphraseSubmit" />
                        <TextBlock x:Name="SeedphraseErrorText"
                                   Style="{StaticResource UrInlineErrorTextStyle}"
                                   Visibility="Collapsed" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Instant account: terms consent and one button (macOS
                     CreateNetworkInstantView). The seedphrase the server
                     returns is shown in a sheet before the device is
                     registered - see SeedphraseDisplaySheet. -->
                <StackPanel x:Name="InstantPanel" Margin="24" Spacing="12"
                            MaxWidth="440" VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <Button x:Name="InstantBackButton" Tag="initial" Click="OnLoginBack" />
                    <!-- the step's fields on a card. Every sign-in step was a bare
                         column floating on the page: at 1000px tall the seedphrase
                         step was ~330px of black, a 400px-wide run of controls, and
                         ~300px more black, with nothing saying where the form began
                         or ended. -->
                    <Border Style="{StaticResource UrCardStyle}" Padding="24">
                        <StackPanel Spacing="12">
                        <TextBlock x:Name="InstantHeading" FontFamily="{StaticResource UrHeadingFontFamily}" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock x:Name="InstantExplanationText" TextWrapping="Wrap"
                                   Foreground="{StaticResource UrTextMutedBrush}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- A bare CheckBox with no content has NO accessible name -
                                 a screen reader announces "checkbox" and nothing else -
                                 so LabeledBy borrows the sentence beside it, the same
                                 way the connect drawer's toggles do.

                                 LabeledBy ALONE is not the whole fix: the label stays
                                 in the control view with the identical string, so the
                                 sentence was announced twice. urnw::PairTermsLabel
                                 (called from LoginPage::ApplyStrings) takes the label
                                 out of the control view and puts its two Hyperlinks
                                 back individually - they are the only keyboard route
                                 to the terms and the privacy policy. -->
                            <CheckBox x:Name="InstantTermsCheck" MinWidth="0" VerticalAlignment="Top"
                                      AutomationProperties.LabeledBy="{Binding ElementName=InstantTermsText}"
                                      Checked="OnInstantTermsChanged" Unchecked="OnInstantTermsChanged" />
                            <!-- inlines with tappable terms/privacy links, set in code -->
                            <TextBlock x:Name="InstantTermsText" Grid.Column="1" TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource UrTextMutedBrush}" />
                        </Grid>
                        <Button x:Name="InstantCreateButton" IsEnabled="False"
                                Style="{StaticResource AccentButtonStyle}"
                                HorizontalAlignment="Stretch" Click="OnCreateInstantSubmit" />
                        <TextBlock x:Name="InstantErrorText"
                                   Style="{StaticResource UrInlineErrorTextStyle}"
                                   Visibility="Collapsed" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Password reset: send the reset link -->
                <StackPanel x:Name="ResetPanel" Margin="24" Spacing="12"
                            MaxWidth="420" VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <Button x:Name="ResetBackButton" Tag="password" Click="OnLoginBack" />
                    <!-- the step's fields on a card. Every sign-in step was a bare
                         column floating on the page: at 1000px tall the seedphrase
                         step was ~330px of black, a 400px-wide run of controls, and
                         ~300px more black, with nothing saying where the form began
                         or ended. -->
                    <Border Style="{StaticResource UrCardStyle}" Padding="24">
                        <StackPanel Spacing="12">
                        <TextBlock x:Name="ResetHeading" FontFamily="{StaticResource UrHeadingFontFamily}" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock x:Name="ResetEmailText"
                                   Foreground="{StaticResource UrTextMutedBrush}" />
                        <TextBlock x:Name="ResetSpamNote" Style="{StaticResource UrSupportingTextStyle}" />
                        <Button x:Name="SendResetButton"
                                Style="{StaticResource AccentButtonStyle}"
                                HorizontalAlignment="Stretch" Click="OnSendResetLink" />
                        <muxc:InfoBar x:Name="ResetInfo" IsOpen="False" IsClosable="False" />
                        </StackPanel>
                    </Border>
                </StackPanel>

            </Grid>
        </ScrollViewer>

        <!-- Home -->
        <!-- same body-face inheritance as LoginRoot, for the whole home tree -->
        <!-- PaneDisplayMode="LeftCompact" - an ICON RAIL, always on screen,
             rather than LeftMinimal's hamburger over nothing. Three things at
             once:
               * it is permanent structure. LeftMinimal drew a 48px hamburger on
                 an otherwise empty left margin and the seven destinations only
                 existed while a flyout was open, so the app had no visible
                 chrome at all - which is most of why it read as buttons on
                 black.
               * it makes the destinations reachable in one click instead of two.
               * it shrinks the light-pane problem: the docked rail is the
                 common case and the acrylic overlay is now the exception. (The
                 overlay is fixed too - see NavigationViewExpandedPaneBackground
                 in App.xaml.)
             Compact/Expanded thresholds are pinned so the mode does NOT change
             with the window width: NavigationView otherwise auto-expands the
             pane past ~1008px, which moves the whole page sideways when the user
             resizes and was how "correct at the default width" kept being wrong
             at another one. The toggle button still opens the labelled overlay. -->
        <!-- IsSettingsVisible="False" is load-bearing: NavigationView adds its OWN
             settings gear by default, IN ADDITION to the explicit SettingsNavItem
             below. That gear's Tag matches none of the six destinations, so
             selecting it collapsed every panel and showed an empty window with no
             way back except picking another destination. -->
        <!-- R1: THE ADAPTIVE 5-DESTINATION SHELL.
             PaneDisplayMode="Auto" restores the native NavigationView adaptivity
             the old build deliberately pinned OFF (LeftCompact at every width):
               * >=1008 epx  expanded pane, icon + LABEL   (OpenPaneLength 220)
               *  641-1007   compact icon rail
               * <=640       overlay pane behind the toggle
             The pinned thresholds and LeftCompact are gone: an icon-only rail in
             a 2000px window was the single biggest 'feels like mobile' signal,
             and the page-shift on expand the old note feared is exactly the
             adaptive behaviour the spec now wants.

             Five primary destinations, three footer. Wallet + Leaderboard merged
             into Earnings (leaderboard is a tab on that destination, not its own
             rail item), and Help / Diagnostics / Settings pinned to the footer
             per the Windows settings-placement guidance.
             Glyphs (Segoe Fluent, 20epx), by what the destination IS:
               E80F Home       home      (connect + protection status)
               E774 Globe      network   (locations / providers)
               E8C7 Wallet     earnings  (wallet + leaderboard)
               E77B Contact    account
               E897 Help       help      (footer; the feedback/support screen)
               EBE8 DevTools   diagnostics (footer; developer / reliability)
               E713 Settings   settings  (footer)
             Labels: home / help / diagnostics have no store key yet, so the
             closest shipped strings are used (Connect / Support / Developer) and
             reported as needed additions. -->
        <muxc:NavigationView x:Name="HomeNav" Grid.Row="1" Visibility="Collapsed"
                             AlwaysShowHeader="False"
                             FontFamily="{StaticResource UrBodyFontFamily}"
                             IsBackButtonVisible="Collapsed" PaneDisplayMode="Auto"
                             OpenPaneLength="220" IsPaneToggleButtonVisible="True"
                             IsSettingsVisible="False"
                             SelectionChanged="OnNavSelectionChanged">
            <muxc:NavigationView.Resources>
                <!-- R1: item height 44 (spec), and the selected pill gets the
                     brand card fill + a 3epx accent indicator (already set as
                     app-level theme keys in App.xaml). -->
                <x:Double x:Key="NavigationViewItemOnLeftMinHeight">44</x:Double>
            </muxc:NavigationView.Resources>
            <!-- The destination title, in the brand DISPLAY face at Title scale
                 (ABC Gravity per the reconciliation: titles/hero/wordmark). The
                 default header renders a plain sans; this makes the page title
                 a brand title. Content is a boxed hstring set per navigation. -->
            <muxc:NavigationView.HeaderTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" Style="{StaticResource UrTitleTextStyle}"
                               Margin="4,4,0,0" />
                </DataTemplate>
            </muxc:NavigationView.HeaderTemplate>
            <muxc:NavigationView.MenuItems>
                <muxc:NavigationViewItem x:Name="ConnectNavItem" Tag="connect" IsSelected="True">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource UrIconFontFamily}" FontSize="20" Glyph="&#xE80F;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem x:Name="NetworkNavItem" Tag="network">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource UrIconFontFamily}" FontSize="20" Glyph="&#xE774;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem x:Name="WalletNavItem" Tag="wallet">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource UrIconFontFamily}" FontSize="20" Glyph="&#xE8C7;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem x:Name="AccountNavItem" Tag="account">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource UrIconFontFamily}" FontSize="20" Glyph="&#xE77B;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
            </muxc:NavigationView.MenuItems>
            <muxc:NavigationView.FooterMenuItems>
                <muxc:NavigationViewItem x:Name="SupportNavItem" Tag="support">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource UrIconFontFamily}" FontSize="20" Glyph="&#xE897;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem x:Name="DeveloperNavItem" Tag="developer">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource UrIconFontFamily}" FontSize="20" Glyph="&#xEBE8;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem x:Name="SettingsNavItem" Tag="settings">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource UrIconFontFamily}" FontSize="20" Glyph="&#xE713;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
            </muxc:NavigationView.FooterMenuItems>
            <!-- The footer ScrollViewer's cached MaxHeight is stamped from
                 whatever the footer measured on its last real layout pass; a
                 collection change re-triggers that measure (see
                 ApplyAdvancedMode), but this spacer still guarantees the last
                 footer item - Settings - never sits flush against the status
                 strip's hairline below it, at any scale factor. -->
            <muxc:NavigationView.PaneFooter>
                <Border Height="8" />
            </muxc:NavigationView.PaneFooter>

            <!-- NO PAGE MARGIN. This Grid used to be Margin="24", which is where
                 every destination's gutter came from. Home is now a full-bleed
                 pane layout and must touch the window edges; the six card-model
                 destinations carry the 24 themselves until they are rebuilt. -->
            <Grid x:Name="HomeContentRoot">
                <!-- ==== HOME: THE PANE SHELL (R3) ==========================
                     Owner verdict on two rounds of card polish: "the UI has
                     barely even changed... Things need to fit in a fill, I guess
                     go with Portmaster looks, less random sized modules and more
                     fit in."

                     What changed is not styling. The card model IS the mobile
                     model - a centred column with a MaxWidth cap, page padding,
                     gutters between rounded islands - and no amount of
                     rebalancing islands makes a 2062dip window look filled. So
                     Home is now built the way SPN/Portmaster builds a window:

                       THREE VERTICAL PANES, floor to ceiling, edge to edge.
                       A 1px rule between them, never a gap.
                       A 40px header strip on each; each scrolls under its own.
                       Inside a pane: 28px group headers and UNIFORM rows.
                       Lists FILL their pane; an empty state is a centred line
                       inside a full-height pane, not a short card in space.

                       col 0  CONNECT     the state, the hero, the primary
                                          action, and every per-connection
                                          decision (provide, mode, switches)
                       col 2  ACTIVITY    the throughput chart across the top of
                                          the pane, then the routing decisions as
                                          a dense uniform table that fills to the
                                          floor
                       col 4  STATISTICS  the detail/inspector: the block and
                                          local charts, session figures,
                                          contracts, split rules and DNS, all as
                                          key/value rows on one grid rhythm

                     Deleted with the card model: ConnectLayout's 1:1000:1
                     centring grid, ConnectCapColumn's MaxWidth, ConnectMainStack
                     / ConnectRail / ConnectStatusStack and the Reparent dance
                     that moved them between three hosts, and every card margin.
                     MainWindow::ApplyBreakpoint now only decides how many PANES
                     fit; it no longer moves any panel between parents.

                     The globe (owner override 3) is kept and lives INSIDE column
                     0's flow, sized to the pane. Its mask takes its colour from
                     the surface behind it, so column 0 is a solid fill. -->
                <Grid x:Name="ConnectView" Style="{StaticResource UrPaneStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="ConnectPaneAColumn" Width="330" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition x:Name="ConnectPaneBColumn" Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition x:Name="ConnectPaneCColumn" Width="380" />
                    </Grid.ColumnDefinitions>

                    <!-- ============ PANE A: CONNECT ============ -->
                    <Grid Grid.Column="0" x:Name="ConnectPaneA"
                          AutomationProperties.LandmarkType="Main">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource UrPaneHeaderStyle}">
                            <Grid>
                                <TextBlock x:Name="PaneATitle"
                                           Style="{StaticResource UrPaneTitleStyle}" />
                                <TextBlock x:Name="PaneAMeta" HorizontalAlignment="Right"
                                           Style="{StaticResource UrPaneMetaStyle}" />
                            </Grid>
                        </Border>
                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- STATUS LEADS. Protection state first, at the top of
                                     the pane, above the ornament. -->
                                <Border Style="{StaticResource UrPaneRowStyle}"
                                        MinHeight="0" Padding="12,14">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <!-- dot on the FIRST line (top + margin), not centred:
                                             the blocked-traffic note below can make this a
                                             multi-line block, and the dot belongs to the
                                             headline it colours (24px line, 10px dot). -->
                                        <Ellipse x:Name="StatusDot" Width="10" Height="10"
                                                 VerticalAlignment="Top" Margin="0,7,0,0" />
                                        <StackPanel Grid.Column="1" Spacing="4"
                                                    VerticalAlignment="Center">
                                            <TextBlock x:Name="StatusText"
                                                       FontFamily="{StaticResource UrBodyFontFamily}"
                                                       FontSize="20" LineHeight="24" FontWeight="SemiBold"
                                                       TextWrapping="Wrap" />
                                            <!-- #27 soft-kill-switch honesty: while the tunnel
                                                 is up with nothing proven (Evaluating /
                                                 Degraded), this says traffic is blocked rather
                                                 than leaking. One writer:
                                                 ConnectPage::ApplyConnectStatus. -->
                                            <TextBlock x:Name="TrafficHeldText"
                                                       Style="{StaticResource UrSupportingTextStyle}"
                                                       TextWrapping="Wrap" TextTrimming="None"
                                                       Visibility="Collapsed" />
                                            <!-- track 2 window honesty: the SDK's stall
                                                 diagnosis as a human sentence while the
                                                 attempt is yellow, and the explanation in
                                                 the failure state. One writer:
                                                 ConnectPage::ApplyConnectStatus. -->
                                            <TextBlock x:Name="StatusReasonText"
                                                       Style="{StaticResource UrSupportingTextStyle}"
                                                       TextWrapping="Wrap" TextTrimming="None"
                                                       Visibility="Collapsed" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <!-- The hero, INSIDE the pane's flow. A Button, so it is
                                     focusable and keyboard-invokable; its content is the
                                     decorative ConnectCanvas host, marked Raw because a
                                     Button whose Content is a Panel gets NO automatic
                                     name - the explicit one is set from
                                     ConnectPage::ApplyConnectStatus. -->
                                <Border BorderBrush="{StaticResource UrBorderBrush}"
                                        BorderThickness="0,0,0,1" Padding="0,8">
                                    <Button x:Name="ConnectHero"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            VerticalContentAlignment="Stretch"
                                            Padding="0" BorderThickness="0"
                                            UseSystemFocusVisuals="False"
                                            Click="OnConnectToggle">
                                        <Button.Resources>
                                            <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
                                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent" />
                                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent" />
                                            <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                                            <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                                            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                                            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                                            <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
                                        </Button.Resources>
                                        <!-- ConnectCanvas clamps its side to [168,288] off the
                                             host WIDTH and writes the host height itself, so
                                             capping the width is how the hero is sized to the
                                             pane rather than to the window. -->
                                        <Grid x:Name="ConnectCanvasHost" MaxWidth="190"
                                              HorizontalAlignment="Center"
                                              AutomationProperties.AccessibilityView="Raw" />
                                    </Button>
                                </Border>
                                <!-- the selected provider; the whole row opens the chooser -->
                                <Button x:Name="LocationRow" MinHeight="48"
                                        Style="{StaticResource UrPaneRowButtonStyle}"
                                        Click="OnLocationRowClick">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="1"
                                                    VerticalAlignment="Center">
                                            <TextBlock x:Name="SelectedProviderLabel" FontSize="11"
                                                       AutomationProperties.AccessibilityView="Raw"
                                                       Foreground="{StaticResource UrTextMutedBrush}" />
                                            <TextBlock x:Name="LocationText" FontSize="14"
                                                       TextTrimming="CharacterEllipsis"
                                                       AutomationProperties.AccessibilityView="Raw" />
                                        </StackPanel>
                                        <FontIcon Grid.Column="1" Glyph="&#xE76C;"
                                                  Style="{StaticResource UrChevronIconStyle}" />
                                    </Grid>
                                </Button>
                                <!-- THE primary action. Its STYLE is assigned from
                                     ConnectPage::ApplyConnectStatus, not fixed here: the
                                     disconnected state is a filled blue Connect and the
                                     connected state is an outlined Disconnect, and the one
                                     function that already derives the status word, the dot
                                     colour and the hero state derives this too. See
                                     UrPaneActionPrimaryStyle in App.xaml for why the
                                     full-bleed lime slab that used to be here is gone. -->
                                <Button x:Name="ConnectButton"
                                        Style="{StaticResource UrPaneActionPrimaryStyle}"
                                        Click="OnConnectToggle" />
                                <!-- network peers (apple ConnectActions parity) -->
                                <Button x:Name="PeersLine" MinHeight="36"
                                        Style="{StaticResource UrPaneRowButtonStyle}"
                                        Click="OnPeersLineClick">
                                    <StackPanel Orientation="Horizontal" Spacing="8"
                                                VerticalAlignment="Center">
                                        <Ellipse x:Name="PeerDot" Width="8" Height="8"
                                                 VerticalAlignment="Center" />
                                        <TextBlock x:Name="PeerCountText" FontSize="12"
                                                   AutomationProperties.AccessibilityView="Raw"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource UrTextMutedBrush}" />
                                    </StackPanel>
                                </Button>
                                <!-- out of balance: the action opens the upgrade flow -->
                                <InfoBar x:Name="BalanceWarning" IsOpen="False" IsClosable="False"
                                         Margin="12,8" Severity="Warning" />
                                <!-- the VPN service needs setting up / starting / updating:
                                     the action is ONE elevated `urnetworkd install`. Title,
                                     message, action label and IsOpen are all written by
                                     ConnectPage::ApplyServiceSetup (one writer, like the
                                     balance bar above); the action button is built in the
                                     MainWindow ctor beside the balance bar's. Package D's
                                     update-available banner stacks directly BELOW this one. -->
                                <InfoBar x:Name="ServiceSetupBar" IsOpen="False" IsClosable="False"
                                         Margin="12,8" Severity="Warning" />
                                <!-- a newer release exists (beta spec §5): one click downloads,
                                     verifies against the asset's SHA-256 digest from the
                                     releases API, rename-swaps the app's own
                                     files and relaunches. Same bar shape and one-writer
                                     discipline as the two above: everything is written by
                                     ConnectPage::ApplyUpdateChecker, and the action button is
                                     built in the MainWindow ctor beside theirs. Severity is
                                     set in code - Informational normally, Error when an apply
                                     failed. After the swap the SERVICE still runs the renamed
                                     old exe by design; the ServiceSetupBar's VersionMismatch
                                     state directly above finishes the job. -->
                                <InfoBar x:Name="UpdateBar" IsOpen="False" IsClosable="False"
                                         Margin="12,8" Severity="Informational" />

                                <!-- provide ....................................... -->
                                <Border Style="{StaticResource UrGroupHeaderStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8"
                                                VerticalAlignment="Center">
                                        <!-- provide indicator (apple parity): solid dot =
                                             Network tier; dot + ring = Public tier -->
                                        <Grid Width="12" Height="12" VerticalAlignment="Center">
                                            <Ellipse x:Name="ProvideModeRing" Width="12" Height="12"
                                                     StrokeThickness="1.5" Visibility="Collapsed" />
                                            <Ellipse x:Name="ProvideModeDot" Width="7" Height="7" />
                                        </Grid>
                                        <TextBlock x:Name="ProvideModeLabel"
                                                   Style="{StaticResource UrGroupHeaderTextStyle}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource UrPaneRowStyle}"
                                        MinHeight="44" Padding="8,4">
                                    <muxc:SelectorBar x:Name="ProvideModeBar"
                                                      VerticalAlignment="Center"
                                                      SelectionChanged="OnProvideModeChanged">
                                        <muxc:SelectorBarItem x:Name="ProvideAutoItem" />
                                        <muxc:SelectorBarItem x:Name="ProvideAlwaysItem" />
                                        <muxc:SelectorBarItem x:Name="ProvideNetworkItem" />
                                        <muxc:SelectorBarItem x:Name="ProvideNeverItem" />
                                    </muxc:SelectorBar>
                                </Border>
                                <Border x:Name="DiscoverableRow"
                                        Style="{StaticResource UrPaneRowStyle}" MinHeight="36">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE704;" FontSize="13"
                                                  Style="{StaticResource UrRowIconStyle}" />
                                        <TextBlock x:Name="DiscoverableText" Grid.Column="1"
                                                   Style="{StaticResource UrKeyTextStyle}"
                                                   FontSize="12" />
                                    </Grid>
                                </Border>
                                <!-- "N clients connected": the ROW collapses when there is
                                     nothing to say, not just its text - a fixed-height row
                                     around a collapsed TextBlock is still a blank row. -->
                                <Border x:Name="ProvideStatsRow" Visibility="Collapsed"
                                        Style="{StaticResource UrPaneRowStyle}" MinHeight="36">
                                    <TextBlock x:Name="ProvideStatsText"
                                               Style="{StaticResource UrKeyTextStyle}"
                                               FontSize="12" />
                                </Border>

                                <!-- connect options ................................ -->
                                <Border Style="{StaticResource UrGroupHeaderStyle}">
                                    <TextBlock x:Name="ConnectOptionsLabel"
                                               Style="{StaticResource UrGroupHeaderTextStyle}" />
                                </Border>
                                <Border Style="{StaticResource UrPaneRowStyle}"
                                        MinHeight="44" Padding="8,4">
                                    <muxc:SelectorBar x:Name="ConnectionModeBar"
                                                      VerticalAlignment="Center"
                                                      SelectionChanged="OnConnectionModeChanged">
                                        <muxc:SelectorBarItem x:Name="ModeAutoItem" />
                                        <muxc:SelectorBarItem x:Name="ModeWebItem" />
                                        <muxc:SelectorBarItem x:Name="ModeStreamingItem" />
                                    </muxc:SelectorBar>
                                </Border>
                                <Border Style="{StaticResource UrPaneRowStyle}">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE71B;" FontSize="14"
                                                  Style="{StaticResource UrRowIconStyle}" />
                                        <TextBlock x:Name="FixedIpLabel" Grid.Column="1"
                                                   Style="{StaticResource UrRowTitleStyle}" />
                                        <ToggleSwitch x:Name="FixedIpToggle" Grid.Column="2" Width="44"
                                                      Style="{StaticResource UrSwitchToggleStyle}"
                                                      AutomationProperties.LabeledBy="{Binding ElementName=FixedIpLabel}"
                                                      Toggled="OnFixedIpToggled" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource UrPaneRowStyle}">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xEA18;" FontSize="14"
                                                  Style="{StaticResource UrRowIconStyle}" />
                                        <TextBlock x:Name="StrongAnonLabel" Grid.Column="1"
                                                   Style="{StaticResource UrRowTitleStyle}" />
                                        <ToggleSwitch x:Name="StrongAnonToggle" Grid.Column="2" Width="44"
                                                      Style="{StaticResource UrSwitchToggleStyle}"
                                                      AutomationProperties.LabeledBy="{Binding ElementName=StrongAnonLabel}"
                                                      Toggled="OnStrongAnonToggled" />
                                    </Grid>
                                </Border>
                                <!-- Post quantum: opportunistic e2e; providers without
                                     support fall back to plaintext at this layer -->
                                <Border Style="{StaticResource UrPaneRowStyle}">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE72E;" FontSize="14"
                                                  Style="{StaticResource UrRowIconStyle}" />
                                        <TextBlock x:Name="PostQuantumLabel" Grid.Column="1"
                                                   Style="{StaticResource UrRowTitleStyle}" />
                                        <ToggleSwitch x:Name="PostQuantumToggle" Grid.Column="2" Width="44"
                                                      Style="{StaticResource UrSwitchToggleStyle}"
                                                      AutomationProperties.LabeledBy="{Binding ElementName=PostQuantumLabel}"
                                                      Toggled="OnPostQuantumToggled" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource UrPaneRowStyle}">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xEA39;" FontSize="14"
                                                  Style="{StaticResource UrRowIconStyle}" />
                                        <TextBlock x:Name="BlockerLabel" Grid.Column="1"
                                                   Style="{StaticResource UrRowTitleStyle}" />
                                        <ToggleSwitch x:Name="BlockerToggle" Grid.Column="2" Width="44"
                                                      Style="{StaticResource UrSwitchToggleStyle}"
                                                      AutomationProperties.LabeledBy="{Binding ElementName=BlockerLabel}"
                                                      Toggled="OnBlockerToggled" />
                                    </Grid>
                                </Border>

                                <!-- network peers ................................. -->
                                <!-- The pane's LIST. Everything above it is a fixed
                                     block of controls, which is what left the connect
                                     column ending two thirds of the way down a
                                     maximized window; the peers are the one feed that
                                     belongs to this pane and can fill it. Same row
                                     species as the activity table. -->
                                <Border Style="{StaticResource UrGroupHeaderStyle}">
                                    <Grid>
                                        <TextBlock x:Name="PeersGroupLabel"
                                                   Style="{StaticResource UrGroupHeaderTextStyle}" />
                                        <TextBlock x:Name="PeersGroupCount" HorizontalAlignment="Right"
                                                   Style="{StaticResource UrPaneMetaStyle}" />
                                    </Grid>
                                </Border>
                                <StackPanel x:Name="PeersHost" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <Border x:Name="ConnectPaneBRule" Grid.Column="1"
                            Style="{StaticResource UrPaneVRuleStyle}" />

                    <!-- ============ PANE B: ACTIVITY ============ -->
                    <Grid Grid.Column="2" x:Name="ConnectPaneB">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource UrPaneHeaderStyle}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="PaneBTitle"
                                           Style="{StaticResource UrPaneTitleStyle}" />
                                <!-- the live down/up rates: the pane's own figure, in its
                                     own header, rather than a line inside a card -->
                                <TextBlock x:Name="ThroughputText" Grid.Column="1"
                                           HorizontalAlignment="Right"
                                           Style="{StaticResource UrPaneMetaStyle}" />
                            </Grid>
                        </Border>
                        <!-- the chart runs the FULL WIDTH of the pane, edge to edge -->
                        <Border Grid.Row="1" BorderBrush="{StaticResource UrBorderBrush}"
                                BorderThickness="0,0,0,1" Padding="12,0">
                            <Grid x:Name="RemoteChartHost" Height="150" />
                        </Border>
                        <!-- The transport distribution bar (TRANSPORTSTATS): the window's
                             remote traffic by transport, directly under the Remote plot and
                             the same 12px inset, so it lines up with it. Built into this host
                             by ConnectPage::BuildCharts (urnw::TransportBar) as ONE pane-row
                             Button (title "Transports", the bar, the legend, the unused
                             footer) whose click opens the transport settings editor. Its
                             own hairline is the row's, so no rule here. -->
                        <Grid Grid.Row="2" x:Name="TransportBarHost" />
                        <Border Grid.Row="3" Style="{StaticResource UrGroupHeaderStyle}">
                            <Grid>
                                <TextBlock x:Name="ConnectionsLabel"
                                           Style="{StaticResource UrGroupHeaderTextStyle}" />
                                <TextBlock x:Name="ConnectionsCount" HorizontalAlignment="Right"
                                           Style="{StaticResource UrPaneMetaStyle}" />
                            </Grid>
                        </Border>
                        <!-- The list FILLS the rest of the pane. Its empty state is a
                             centred line in that same full-height area, never a short
                             card floating in space. -->
                        <Grid Grid.Row="4">
                            <ScrollViewer x:Name="ConnectionsScroll"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="ConnectionsHost" />
                            </ScrollViewer>
                            <StackPanel x:Name="SessionEmptyCard" Spacing="8"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        IsHitTestVisible="False">
                                <FontIcon Glyph="&#xE9D2;" Style="{StaticResource UrEmptyGlyphStyle}" />
                                <TextBlock x:Name="SessionEmptyText" TextAlignment="Center"
                                           Style="{StaticResource UrSupportingTextStyle}" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <Border x:Name="ConnectPaneCRule" Grid.Column="3"
                            Style="{StaticResource UrPaneVRuleStyle}" />

                    <!-- ============ PANE C: STATISTICS / INSPECTOR ============ -->
                    <Grid Grid.Column="4" x:Name="ConnectPaneC">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource UrPaneHeaderStyle}">
                            <Grid>
                                <TextBlock x:Name="PaneCTitle"
                                           Style="{StaticResource UrPaneTitleStyle}" />
                            </Grid>
                        </Border>
                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- ==== THE CONNECTION INSPECTOR (D5) ==================
                                     The Portmaster ask, and the reason the spec called
                                     this column "detail/inspector for the selection"
                                     from the start. It is Advanced Mode only: in Normal
                                     the whole group is collapsed and the pane is the
                                     statistics pane it has always been. In Advanced the
                                     Activity pane's rows become selectable and this
                                     paints whatever is selected.

                                     It sits ABOVE the charts on purpose. The selection
                                     is the most specific thing on the screen and the
                                     charts are the least; a detail pane that makes you
                                     scroll past two charts to reach the detail is a
                                     statistics pane with an inspector bolted on.

                                     A LANDMARK, named from code (a landmark with no
                                     name is an unlabelled region, which is worse for a
                                     screen reader than no landmark at all). Every row
                                     inside is built by ConnectPage::ApplyInspector on
                                     the same key/value rhythm as the session figures. -->
                                <StackPanel x:Name="InspectorGroup" Visibility="Collapsed"
                                            AutomationProperties.LandmarkType="Custom">
                                    <Border Style="{StaticResource UrGroupHeaderStyle}">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="InspectorLabel"
                                                       Style="{StaticResource UrGroupHeaderTextStyle}" />
                                            <!-- clear the selection; collapsed until
                                                 there is one to clear -->
                                            <Button x:Name="InspectorClearButton" Grid.Column="1"
                                                    Visibility="Collapsed"
                                                    Style="{StaticResource UrPaneActionButtonStyle}"
                                                    Click="OnInspectorClear">
                                                <FontIcon Glyph="&#xE711;" FontSize="12"
                                                          Style="{StaticResource UrRowIconStyle}" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                    <!-- the selection's headline: what it is, and the
                                         verdict, which are the two facts the row in the
                                         other pane was already showing -->
                                    <Border x:Name="InspectorHeadline"
                                            Style="{StaticResource UrPaneRowStyle}"
                                            MinHeight="0" Padding="12,10">
                                        <StackPanel Spacing="3">
                                            <TextBlock x:Name="InspectorTitle" FontSize="15"
                                                       FontWeight="SemiBold"
                                                       FontFamily="{StaticResource UrBodyFontFamily}"
                                                       Foreground="{StaticResource UrTextBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="NoWrap" />
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <Ellipse x:Name="InspectorDot" Width="8" Height="8"
                                                         VerticalAlignment="Center"
                                                         AutomationProperties.AccessibilityView="Raw" />
                                                <TextBlock x:Name="InspectorVerdict" FontSize="12"
                                                           Style="{StaticResource UrKeyTextStyle}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <!-- and the fields, from ConnectPage::ApplyInspector -->
                                    <StackPanel x:Name="InspectorRowsHost" />
                                </StackPanel>

                                <!-- two charts, the SAME height, full width of the pane -->
                                <Border BorderBrush="{StaticResource UrBorderBrush}"
                                        BorderThickness="0,0,0,1" Padding="12,0">
                                    <Grid x:Name="BlockedChartHost" Height="132" />
                                </Border>
                                <Border BorderBrush="{StaticResource UrBorderBrush}"
                                        BorderThickness="0,0,0,1" Padding="12,0">
                                    <Grid x:Name="LocalChartHost" Height="132" />
                                </Border>

                                <!-- session figures ............................... -->
                                <Border Style="{StaticResource UrGroupHeaderStyle}">
                                    <TextBlock x:Name="DataUsageLabel"
                                               Style="{StaticResource UrGroupHeaderTextStyle}" />
                                </Border>
                                <StackPanel x:Name="LiveStatsGroup" Visibility="Collapsed">
                                    <!-- the connected providers and where they are: this row
                                         opens the globe sheet (android ProviderLocationsScreen
                                         parity). A Button on the pane-row style rather than a
                                         Border with Tapped, so it keeps the pane rhythm and is
                                         reachable from the keyboard like every other row. -->
                                    <Button x:Name="ProviderCountLine" MinHeight="34"
                                            Style="{StaticResource UrPaneRowButtonStyle}"
                                            Click="OnProviderCountClick">
                                        <!-- the caret says the line opens the provider
                                             details, as on iOS -->
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock x:Name="ProviderCountText"
                                                       Style="{StaticResource UrKeyTextStyle}"
                                                       VerticalAlignment="Center" />
                                            <FontIcon Glyph="&#xE76C;" FontSize="12"
                                                      FontFamily="{StaticResource UrIconFontFamily}"
                                                      Foreground="{StaticResource UrTextMutedBrush}"
                                                      VerticalAlignment="Center"
                                                      AutomationProperties.AccessibilityView="Raw" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <!-- the key/value rows are built into this host by
                                     ConnectPage::ApplySessionRows, on one grid rhythm -->
                                <StackPanel x:Name="SessionRowsHost" />

                                <!-- contracts ..................................... -->
                                <Border Style="{StaticResource UrGroupHeaderStyle}">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="ClientStatsLabel"
                                                   Style="{StaticResource UrGroupHeaderTextStyle}" />
                                        <!-- was a whole card; it is now the group's action.
                                             Opens the same live-contracts sheet. -->
                                        <Button x:Name="ClientStatsCard" Grid.Column="1"
                                                Style="{StaticResource UrPaneActionButtonStyle}"
                                                Click="OnClientStatsCardClick">
                                            <FontIcon Glyph="&#xE8A7;" FontSize="12"
                                                      Style="{StaticResource UrRowIconStyle}" />
                                        </Button>
                                    </Grid>
                                </Border>
                                <StackPanel x:Name="ContractsHost" />

                                <!-- split rules ................................... -->
                                <Border Style="{StaticResource UrGroupHeaderStyle}">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="LocalStatsLabel"
                                                   Style="{StaticResource UrGroupHeaderTextStyle}" />
                                        <TextBlock x:Name="SplitRuleCountText" Grid.Column="1"
                                                   Style="{StaticResource UrPaneMetaStyle}" />
                                        <Button x:Name="LocalStatsCard" Grid.Column="2"
                                                Style="{StaticResource UrPaneActionButtonStyle}"
                                                Click="OnLocalStatsCardClick">
                                            <FontIcon Glyph="&#xE8A7;" FontSize="12"
                                                      Style="{StaticResource UrRowIconStyle}" />
                                        </Button>
                                    </Grid>
                                </Border>
                                <StackPanel x:Name="SplitRulesHost" />

                                <!-- custom dns .................................... -->
                                <Border Style="{StaticResource UrGroupHeaderStyle}">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="DnsCardLabel"
                                                   Style="{StaticResource UrGroupHeaderTextStyle}" />
                                        <Button x:Name="DnsCard" Grid.Column="1"
                                                Style="{StaticResource UrPaneActionButtonStyle}"
                                                Click="OnDnsCardClick">
                                            <FontIcon Glyph="&#xE70F;" FontSize="12"
                                                      Style="{StaticResource UrRowIconStyle}" />
                                        </Button>
                                    </Grid>
                                </Border>
                                <!-- unapplied-recommendation pill (iOS DnsRecommendationPill
                                     parity), as a row rather than a floating chip -->
                                <Border x:Name="DnsRecPill" Visibility="Collapsed"
                                        Style="{StaticResource UrPaneRowStyle}" MinHeight="34"
                                        Background="{StaticResource UrCoralSubtleBrush}">
                                    <StackPanel Orientation="Horizontal" Spacing="6"
                                                VerticalAlignment="Center">
                                        <Ellipse x:Name="DnsRecDot" Width="7" Height="7"
                                                 VerticalAlignment="Center"
                                                 Visibility="Collapsed" />
                                        <TextBlock x:Name="DnsRecText" FontSize="12"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource UrTextBrush}" />
                                    </StackPanel>
                                </Border>
                                <StackPanel x:Name="DnsRowsPanel">
                                    <Border Style="{StaticResource UrPaneRowStyle}" MinHeight="34">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse x:Name="DohDot" Width="6" Height="6"
                                                     VerticalAlignment="Center" />
                                            <TextBlock x:Name="DohLabel" Grid.Column="1"
                                                       Style="{StaticResource UrKeyTextStyle}" />
                                            <TextBlock x:Name="DohState" Grid.Column="2"
                                                       Style="{StaticResource UrValueTextStyle}"
                                                       FontSize="12" />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource UrPaneRowStyle}" MinHeight="34">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse x:Name="UdnsDot" Width="6" Height="6"
                                                     VerticalAlignment="Center" />
                                            <TextBlock x:Name="UdnsLabel" Grid.Column="1"
                                                       Style="{StaticResource UrKeyTextStyle}" />
                                            <TextBlock x:Name="UdnsState" Grid.Column="2"
                                                       Style="{StaticResource UrValueTextStyle}"
                                                       FontSize="12" />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource UrPaneRowStyle}" MinHeight="34">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse x:Name="LdnsDot" Width="6" Height="6"
                                                     VerticalAlignment="Center" />
                                            <TextBlock x:Name="LdnsLabel" Grid.Column="1"
                                                       Style="{StaticResource UrKeyTextStyle}" />
                                            <TextBlock x:Name="LdnsState" Grid.Column="2"
                                                       Style="{StaticResource UrValueTextStyle}"
                                                       FontSize="12" />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource UrPaneRowStyle}" MinHeight="34">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse x:Name="FallbackDot" Width="6" Height="6"
                                                     VerticalAlignment="Center" />
                                            <TextBlock x:Name="FallbackLabel" Grid.Column="1"
                                                       Style="{StaticResource UrKeyTextStyle}" />
                                            <TextBlock x:Name="FallbackState" Grid.Column="2"
                                                       Style="{StaticResource UrValueTextStyle}"
                                                       FontSize="12" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                                <Border x:Name="DnsUnavailableRow" Visibility="Collapsed"
                                        Style="{StaticResource UrPaneRowStyle}" MinHeight="34">
                                    <TextBlock x:Name="DnsUnavailableText"
                                               Style="{StaticResource UrKeyTextStyle}"
                                               Foreground="{StaticResource UrTextFaintBrush}" />
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- ==== NETWORK: THE PANE SHELL (R4) ======================
                     Was a page shell around one card whose only affordance
                     opened the ContentDialog chooser - measured at 95% empty
                     background maximized, the worst screen in the app. It is
                     now the chooser AS A DESTINATION, in Home's idiom:

                       col 0  LOCATIONS   search over the SDK's own buckets
                                          (peers / best available / countries /
                                          regions / cities / devices) as ONE row
                                          species that fills to the floor
                       col 2  DETAIL      what the selected provider IS, the
                                          bucket counts behind the list, and
                                          blocked locations

                     Everything in both panes is built by urnw::NetworkPage
                     (LocationSheets.cpp - the locations unit) into the named
                     hosts below, off the SAME two SDK feeds the chooser sheet
                     reads (SdkHost::SetLocationsObserver). The sheet still
                     exists and Home still opens it; this is a second view of
                     one model, not a fork of it.

                     NOTHING HERE IS INVENTED. ConnectLocation carries name,
                     provider_count, location_type, city/region/country,
                     stable, strong_privacy and promoted, and those are exactly
                     the detail rows. There is no latency and no load figure in
                     the SDK, so there is no latency and no load column. -->
                <Grid x:Name="NetworkView" Visibility="Collapsed"
                      Style="{StaticResource UrPaneStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="NetworkPaneAColumn" Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition x:Name="NetworkPaneBColumn" Width="400" />
                    </Grid.ColumnDefinitions>

                    <!-- ============ PANE A: LOCATIONS ============ -->
                    <Grid Grid.Column="0" x:Name="NetworkPaneA"
                          AutomationProperties.LandmarkType="Main">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource UrPaneHeaderStyle}">
                            <Grid>
                                <TextBlock x:Name="NetworkPaneATitle"
                                           Style="{StaticResource UrPaneTitleStyle}" />
                                <TextBlock x:Name="NetworkPaneAMeta" HorizontalAlignment="Right"
                                           Style="{StaticResource UrPaneMetaStyle}" />
                            </Grid>
                        </Border>
                        <!-- the search row, built by NetworkPage so the field and
                             its SDK filter live in one place -->
                        <Grid Grid.Row="1" x:Name="NetworkSearchHost" />
                        <!-- The list FILLS the rest of the pane, and its empty
                             state is a centred line in that same full-height
                             area - never a short card at the top of it. -->
                        <Grid Grid.Row="2">
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="NetworkListHost" />
                            </ScrollViewer>
                            <Grid x:Name="NetworkListEmptyHost" IsHitTestVisible="False" />
                        </Grid>
                    </Grid>

                    <Border x:Name="NetworkPaneBRule" Grid.Column="1"
                            Style="{StaticResource UrPaneVRuleStyle}" />

                    <!-- ============ PANE B: DETAIL ============ -->
                    <Grid Grid.Column="2" x:Name="NetworkPaneB">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource UrPaneHeaderStyle}">
                            <Grid>
                                <TextBlock x:Name="NetworkPaneBTitle"
                                           Style="{StaticResource UrPaneTitleStyle}" />
                                <TextBlock x:Name="NetworkPaneBMeta" HorizontalAlignment="Right"
                                           Style="{StaticResource UrPaneMetaStyle}" />
                            </Grid>
                        </Border>
                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="NetworkDetailHost" />
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- ==== ACCOUNT: THE PANE SHELL (R4) ======================
                     Spec override #2 makes this the destination that OWNS the
                     account: what the plan is, who the network is, how it signs
                     in, who referred it, and what it has redeemed. Login
                     methods, the auth code, the client id, the bonus referral
                     code, the referral network, Manage Subscription, Sign out
                     and Delete account all MOVED here out of Settings. The
                     builders that make them still live in SettingsPage - it
                     owns their sheets, their loads and their echo guards - and
                     now build into this page's hosts instead of into its own.
                     See SettingsPage::BuildSections.

                       col 0  PLAN     the plan, the usage bar, the upgrade and
                                       redeem actions, subscription management
                       col 2  ACCOUNT  identity as ONE list of uniform rows -
                                       profile, security, referrals, and the
                                       irreversible end
                       col 4  CODES    the redeemed balance codes, as a table
                                       filling to the floor

                     The profile name is an EXPLICIT edit mode (spec, Profile):
                     the row shows the name, the pencil opens a field, and Save
                     exists only while editing. It used to be a permanently-open
                     TextBox with a permanently-enabled Save button under it,
                     which is a form, not a profile. -->
                <Grid x:Name="AccountView" Visibility="Collapsed"
                      Style="{StaticResource UrPaneStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="AccountPaneAColumn" Width="360" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition x:Name="AccountPaneBColumn" Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition x:Name="AccountPaneCColumn" Width="380" />
                    </Grid.ColumnDefinitions>

                    <!-- ============ PANE A: PLAN ============ -->
                    <Grid Grid.Column="0" x:Name="AccountPaneA">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource UrPaneHeaderStyle}">
                            <Grid>
                                <TextBlock x:Name="AccountPaneATitle"
                                           Style="{StaticResource UrPaneTitleStyle}" />
                                <StackPanel Orientation="Horizontal" Spacing="8"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                    <muxc:ProgressRing x:Name="AccountPlanRing" Width="14" Height="14"
                                                       IsActive="False" Visibility="Collapsed" />
                                    <TextBlock x:Name="AccountPaneAMeta"
                                               Style="{StaticResource UrPaneMetaStyle}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- WHAT THE PLAN IS. It leads the pane, the way
                                     the protection state leads Home's. -->
                                <Border Style="{StaticResource UrPaneRowStyle}"
                                        MinHeight="0" Padding="12,14">
                                    <TextBlock x:Name="AccountPlanValueText"
                                               FontFamily="{StaticResource UrBodyFontFamily}"
                                               FontSize="22" FontWeight="SemiBold" />
                                </Border>
                                <!-- the usage bar, full width of the pane, on the
                                     same rhythm as Home's charts -->
                                <Border BorderBrush="{StaticResource UrBorderBrush}"
                                        BorderThickness="0,0,0,1" Padding="12,10">
                                    <StackPanel Spacing="8">
                                        <Grid x:Name="AccountUsageBarHost" Height="32" />
                                        <StackPanel x:Name="AccountUsageLegend"
                                                    Orientation="Horizontal" Spacing="16" />
                                    </StackPanel>
                                </Border>
                                <!-- the pane's primary command: a full-bleed bar -->
                                <Button x:Name="AccountUpgradeButton"
                                        Style="{StaticResource UrPaneActionPrimaryStyle}"
                                        Click="OnOpenUpgrade" />

                                <Border Style="{StaticResource UrGroupHeaderStyle}">
                                    <TextBlock x:Name="AccountUsageGroupLabel"
                                               Style="{StaticResource UrGroupHeaderTextStyle}" />
                                </Border>
                                <Border Style="{StaticResource UrPaneRowStyle}" MinHeight="34">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="AccountDailyLabel"
                                                   Style="{StaticResource UrKeyTextStyle}" />
                                        <TextBlock x:Name="AccountDailyValue" Grid.Column="1"
                                                   Style="{StaticResource UrValueTextStyle}" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource UrPaneRowStyle}" MinHeight="34">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="AccountReferralTotals"
                                                   Style="{StaticResource UrKeyTextStyle}" />
                                        <TextBlock x:Name="AccountReferralBonus" Grid.Column="1"
                                                   Style="{StaticResource UrValueTextStyle}" />
                                    </Grid>
                                </Border>
                                <Button x:Name="RedeemRowButton" MinHeight="40"
                                        Style="{StaticResource UrPaneRowButtonStyle}"
                                        Click="OnOpenRedeem">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="RedeemRowText"
                                                   Style="{StaticResource UrRowTitleStyle}"
                                                   AutomationProperties.AccessibilityView="Raw" />
                                        <FontIcon Grid.Column="1" Glyph="&#xE76C;"
                                                  Style="{StaticResource UrChevronIconStyle}" />
                                    </Grid>
                                </Button>
                                <!-- Manage Subscription, moved out of Settings
                                     (SettingsPage::BuildSubscriptionSection) -->
                                <StackPanel x:Name="AccountPlanExtraHost" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <Border x:Name="AccountPaneBRule" Grid.Column="1"
                            Style="{StaticResource UrPaneVRuleStyle}" />

                    <!-- ============ PANE B: ACCOUNT ============ -->
                    <Grid Grid.Column="2" x:Name="AccountPaneB"
                          AutomationProperties.LandmarkType="Main">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource UrPaneHeaderStyle}">
                            <Grid>
                                <TextBlock x:Name="AccountPaneBTitle"
                                           Style="{StaticResource UrPaneTitleStyle}" />
                            </Grid>
                        </Border>
                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- profile ...................................... -->
                                <Border Style="{StaticResource UrGroupHeaderStyle}">
                                    <TextBlock x:Name="AccountProfileGroupLabel"
                                               Style="{StaticResource UrGroupHeaderTextStyle}" />
                                </Border>
                                <!-- VIEW mode: the name, and the pencil that opens
                                     the editor. -->
                                <Button x:Name="NetworkNameRow" MinHeight="44"
                                        Style="{StaticResource UrPaneRowButtonStyle}"
                                        Click="OnEditNetworkName">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="AccountNetworkNameLabel"
                                                   Style="{StaticResource UrRowTitleStyle}"
                                                   AutomationProperties.AccessibilityView="Raw" />
                                        <TextBlock x:Name="NetworkNameValue" Grid.Column="1"
                                                   Style="{StaticResource UrValueTextStyle}"
                                                   Foreground="{StaticResource UrTextMutedBrush}" />
                                        <FontIcon Grid.Column="2" Glyph="&#xE70F;" FontSize="12"
                                                  Style="{StaticResource UrRowIconStyle}"
                                                  AutomationProperties.AccessibilityView="Raw" />
                                    </Grid>
                                </Button>
                                <!-- EDIT mode: the field, and Save/Cancel that
                                     exist ONLY here. -->
                                <Border x:Name="NetworkNameEditPanel" Visibility="Collapsed"
                                        BorderBrush="{StaticResource UrBorderBrush}"
                                        BorderThickness="0,0,0,1" Padding="12,10"
                                        Background="{StaticResource UrSheetBrush}">
                                    <StackPanel Spacing="10">
                                        <TextBox x:Name="NetworkNameBox"
                                                 Style="{StaticResource UrTextInputStyle}" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button x:Name="SaveNameButton" Click="OnSaveNetworkName" />
                                            <Button x:Name="CancelNameButton" Click="OnCancelNetworkName" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <!-- Collapsed until there IS an auth to describe.
                                     A fixed-height row around an empty TextBlock
                                     is still an empty row, and it opened a 38px
                                     hole in the middle of the profile group. -->
                                <Border x:Name="AccountAuthRow" Visibility="Collapsed"
                                        Style="{StaticResource UrPaneRowStyle}" MinHeight="38">
                                    <TextBlock x:Name="AccountAuthText"
                                               Style="{StaticResource UrKeyTextStyle}" />
                                </Border>
                                <!-- name-availability line + change password
                                     (AccountPage::BuildProfileExtra) -->
                                <StackPanel x:Name="AccountProfileExtra" />

                                <!-- security: login methods, auth code, client id,
                                     all moved out of Settings -->
                                <StackPanel x:Name="AccountSecurityHost" />

                                <!-- referrals: one row that opens the "Refer and earn"
                                     page (ReferralsView below); the code, the figures
                                     and the referral network live there now -->
                                <Border Style="{StaticResource UrGroupHeaderStyle}">
                                    <TextBlock x:Name="AccountReferralsGroupLabel"
                                               Style="{StaticResource UrGroupHeaderTextStyle}" />
                                </Border>
                                <StackPanel x:Name="AccountReferralsNavHost" />

                                <!-- the irreversible end, last on the page at
                                     every width -->
                                <Border Style="{StaticResource UrGroupHeaderStyle}">
                                    <TextBlock x:Name="SettingsAccountHeading"
                                               Style="{StaticResource UrGroupHeaderTextStyle}" />
                                </Border>
                                <StackPanel x:Name="AccountDangerHost" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <Border x:Name="AccountPaneCRule" Grid.Column="3"
                            Style="{StaticResource UrPaneVRuleStyle}" />

                    <!-- ============ PANE C: BALANCE CODES ============ -->
                    <Grid Grid.Column="4" x:Name="AccountPaneC">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource UrPaneHeaderStyle}">
                            <Grid>
                                <TextBlock x:Name="AccountPaneCTitle"
                                           Style="{StaticResource UrPaneTitleStyle}" />
                                <TextBlock x:Name="AccountPaneCMeta" HorizontalAlignment="Right"
                                           Style="{StaticResource UrPaneMetaStyle}" />
                            </Grid>
                        </Border>
                        <Grid Grid.Row="1">
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="BalanceCodesPanel" />
                            </ScrollViewer>
                            <!-- one centred line in a FULL-HEIGHT pane, never a
                                 short card at the top of one -->
                            <TextBlock x:Name="BalanceCodesEmptyText"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       TextAlignment="Center" TextWrapping="Wrap" MaxWidth="300"
                                       Margin="16" IsHitTestVisible="False"
                                       Style="{StaticResource UrSupportingTextStyle}" />
                        </Grid>
                    </Grid>
                </Grid>

                <!-- ============ REFERRALS: the "Refer and earn" page ============
                     Reached from Account's Referrals row; it has no rail item of its
                     own, so the pane header carries "‹ Account". The shared referral
                     card (progress box + gold panel - ReferralCard.h), the figures and
                     the referral-network row are built by ReferralsPage into the two
                     hosts (SettingsPage still builds the referral-network row, which
                     owns that sheet). -->
                <Grid x:Name="ReferralsView" Visibility="Collapsed"
                      Style="{StaticResource UrPaneStyle}">
                    <Grid x:Name="ReferralsPane" AutomationProperties.LandmarkType="Main">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource UrPaneHeaderStyle}">
                            <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="12"
                                            VerticalAlignment="Center">
                                    <Button x:Name="ReferralsBackButton" Padding="8,4" />
                                    <TextBlock x:Name="ReferralsPaneTitle" VerticalAlignment="Center"
                                               Style="{StaticResource UrPaneTitleStyle}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel MaxWidth="760" HorizontalAlignment="Stretch">
                                <StackPanel x:Name="ReferralsHost" />
                                <StackPanel x:Name="ReferralsNetworkHost" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- ==== EARNINGS: THE PANE SHELL (R4) =====================
                     Earnings and Leaderboard are one destination: what the
                     network earned, and where it stands. Points first: points
                     are URnetwork's own system and always the headline. The
                     subnet layer (a Bittensor coldkey, unclaimed SN25a, the
                     claim dialog, the alpha column) appears only once a wallet
                     is connected, and is never retroactive.

                       col 0  EARNINGS   the points figure and its breakdown,
                                         the protocol note, the Bittensor
                                         wallet, the unclaimed tile, Top 200
                       col 2  LEDGER     the per-epoch history table, and the
                                         leaderboard table, one at a time, both
                                         filling to the floor
                       col 4  NETWORK    why the number is what it is - own
                                         rank, the Seeker multiplier, reliability

                     THE LEDGER PANE IS TABBED: history and the leaderboard are
                     both wide multi-column tables that want the same space,
                     and neither is worth reading four columns at a time in a
                     380dip rail. One pane, one table at a time, the switch in
                     the pane's own header strip.

                     Everything dynamic is built by WalletPage into the named
                     hosts below. -->
                <Grid x:Name="WalletView" Visibility="Collapsed"
                      Style="{StaticResource UrPaneStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="WalletPaneAColumn" Width="360" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition x:Name="WalletPaneBColumn" Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition x:Name="WalletPaneCColumn" Width="380" />
                    </Grid.ColumnDefinitions>

                    <!-- ============ PANE A: EARNINGS ============ -->
                    <Grid Grid.Column="0" x:Name="WalletPaneA">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource UrPaneHeaderStyle}">
                            <Grid>
                                <TextBlock x:Name="WalletPaneATitle"
                                           Style="{StaticResource UrPaneTitleStyle}" />
                                <TextBlock x:Name="WalletPaneAMeta" HorizontalAlignment="Right"
                                           Style="{StaticResource UrPaneMetaStyle}" />
                            </Grid>
                        </Border>
                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- THE FIGURE: net points, in the display face,
                                     with its caption and the fetch state beside
                                     it. The breakdown rows follow on the pane's
                                     grid. -->
                                <Border Style="{StaticResource UrPaneRowStyle}"
                                        MinHeight="0" Padding="12,14,12,10">
                                    <StackPanel Spacing="2">
                                        <TextBlock x:Name="PointsHeadlineValue"
                                                   FontFamily="{StaticResource UrHeadingCondensedFontFamily}"
                                                   FontSize="44" />
                                        <Grid>
                                            <TextBlock x:Name="PointsHeadlineLabel"
                                                       Style="{StaticResource UrKeyTextStyle}" />
                                            <TextBlock x:Name="AccountPointsStatusText"
                                                       HorizontalAlignment="Right"
                                                       Style="{StaticResource UrPaneMetaStyle}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <StackPanel x:Name="AccountPointsPanel" />

                                <!-- the protocol note and the ur.xyz link -->
                                <Border BorderBrush="{StaticResource UrBorderBrush}"
                                        BorderThickness="0,0,0,1" Padding="12,10">
                                    <StackPanel Spacing="4">
                                        <TextBlock x:Name="ProtocolNoteText" TextWrapping="Wrap"
                                                   Style="{StaticResource UrRowNoteStyle}"
                                                   TextTrimming="None" />
                                        <HyperlinkButton x:Name="LearnUrXyzButton"
                                                         Padding="0" Margin="0"
                                                         HorizontalAlignment="Left"
                                                         Click="OnLearnUrXyz" />
                                    </StackPanel>
                                </Border>

                                <!-- bittensor wallet ........................... -->
                                <Border Style="{StaticResource UrGroupHeaderStyle}">
                                    <Grid>
                                        <TextBlock x:Name="BittensorWalletHeading"
                                                   Style="{StaticResource UrGroupHeaderTextStyle}" />
                                        <TextBlock x:Name="WalletStatusText"
                                                   HorizontalAlignment="Right"
                                                   Style="{StaticResource UrPaneMetaStyle}" />
                                    </Grid>
                                </Border>
                                <!-- connected: the coldkey, what it means, change -->
                                <Border x:Name="WalletConnectedPanel" Visibility="Collapsed"
                                        BorderBrush="{StaticResource UrBorderBrush}"
                                        BorderThickness="0,0,0,1" Padding="12,10">
                                    <StackPanel Spacing="8">
                                        <TextBlock x:Name="WalletAddressText"
                                                   Style="{StaticResource UrKeyTextStyle}"
                                                   IsTextSelectionEnabled="True"
                                                   TextWrapping="Wrap" TextTrimming="None" />
                                        <TextBlock x:Name="WalletConnectedNote" TextWrapping="Wrap"
                                                   Style="{StaticResource UrRowNoteStyle}"
                                                   TextTrimming="None" />
                                        <Button x:Name="ChangeWalletButton"
                                                Style="{StaticResource UrPaneActionSecondaryStyle}"
                                                HorizontalAlignment="Stretch"
                                                Click="OnChangeWallet" />
                                    </StackPanel>
                                </Border>
                                <!-- not connected: the not-retroactive line, the
                                     bridge button, and the manual paste fallback
                                     (still signed) folded under a link -->
                                <Border x:Name="WalletDisconnectedPanel"
                                        BorderBrush="{StaticResource UrBorderBrush}"
                                        BorderThickness="0,0,0,1" Padding="12,10">
                                    <StackPanel Spacing="10">
                                        <TextBlock x:Name="WalletNotRetroactiveText" TextWrapping="Wrap"
                                                   Style="{StaticResource UrRowNoteStyle}"
                                                   TextTrimming="None" />
                                        <Button x:Name="ConnectWalletButton"
                                                Style="{StaticResource UrPaneActionPrimaryStyle}"
                                                HorizontalAlignment="Stretch"
                                                Click="OnConnectWallet" />
                                        <TextBlock x:Name="WalletConnectStatusText" TextWrapping="Wrap"
                                                   Style="{StaticResource UrRowNoteStyle}"
                                                   TextTrimming="None" Visibility="Collapsed" />
                                        <HyperlinkButton x:Name="EnterAddressManuallyButton"
                                                         Padding="0" Margin="0"
                                                         HorizontalAlignment="Left"
                                                         Click="OnEnterAddressManually" />
                                        <StackPanel x:Name="ManualAddressPanel" Visibility="Collapsed"
                                                    Spacing="8">
                                            <TextBox x:Name="WalletAddressBox"
                                                     Style="{StaticResource UrTextInputStyle}"
                                                     TextChanged="OnWalletAddressChanged" />
                                            <TextBlock x:Name="WalletAddressVerdictText"
                                                       Style="{StaticResource UrRowNoteStyle}"
                                                       TextTrimming="None" TextWrapping="Wrap" />
                                            <Button x:Name="ConnectAddressButton"
                                                    Style="{StaticResource UrPaneActionSecondaryStyle}"
                                                    HorizontalAlignment="Stretch"
                                                    IsEnabled="False"
                                                    Click="OnConnectWalletAddress" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- unclaimed SN25a: only with a wallet .......... -->
                                <StackPanel x:Name="UnclaimedPanel" Visibility="Collapsed">
                                    <Border Style="{StaticResource UrGroupHeaderStyle}">
                                        <Grid>
                                            <TextBlock x:Name="UnclaimedHeading"
                                                       Style="{StaticResource UrGroupHeaderTextStyle}" />
                                            <TextBlock x:Name="ClaimsStatusText"
                                                       HorizontalAlignment="Right"
                                                       Style="{StaticResource UrPaneMetaStyle}" />
                                        </Grid>
                                    </Border>
                                    <Border BorderBrush="{StaticResource UrBorderBrush}"
                                            BorderThickness="0,0,0,1" Padding="12,10">
                                        <StackPanel Spacing="6">
                                            <TextBlock x:Name="UnclaimedValue"
                                                       FontFamily="{StaticResource UrHeadingCondensedFontFamily}"
                                                       FontSize="32" />
                                            <TextBlock x:Name="UnclaimedNote" TextWrapping="Wrap"
                                                       Style="{StaticResource UrRowNoteStyle}"
                                                       TextTrimming="None" />
                                            <Button x:Name="ClaimButton"
                                                    Style="{StaticResource UrPaneActionPrimaryStyle}"
                                                    HorizontalAlignment="Stretch"
                                                    IsEnabled="False"
                                                    Click="OnClaimAlpha" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- top 200: a head mining spot .................. -->
                                <StackPanel x:Name="Top200Panel" Visibility="Collapsed">
                                    <Border Style="{StaticResource UrGroupHeaderStyle}">
                                        <TextBlock x:Name="Top200Heading"
                                                   Style="{StaticResource UrGroupHeaderTextStyle}" />
                                    </Border>
                                    <Border x:Name="Top200Card"
                                            BorderBrush="{StaticResource UrReferralGoldBrush}"
                                            BorderThickness="0,0,0,1" Padding="12,10">
                                        <StackPanel Spacing="6">
                                            <TextBlock x:Name="Top200Status"
                                                       Style="{StaticResource UrKeyTextStyle}"
                                                       Foreground="{StaticResource UrReferralGoldLightBrush}"
                                                       TextWrapping="Wrap" TextTrimming="None" />
                                            <TextBlock x:Name="Top200Detail" TextWrapping="Wrap"
                                                       Style="{StaticResource UrRowNoteStyle}"
                                                       TextTrimming="None" />
                                            <TextBlock x:Name="Top200Warning" TextWrapping="Wrap"
                                                       Style="{StaticResource UrRowNoteStyle}"
                                                       Foreground="{StaticResource UrReferralGoldLightBrush}"
                                                       TextTrimming="None" Visibility="Collapsed" />
                                            <Button x:Name="Top200Button"
                                                    Style="{StaticResource UrPaneActionSecondaryStyle}"
                                                    HorizontalAlignment="Stretch"
                                                    Click="OnClaimTop200" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- the checkout stays where it was: a signed-in
                                     free account can upgrade from here; the
                                     window owns its visibility -->
                                <Button x:Name="UpgradeButton"
                                        Style="{StaticResource UrPaneActionPrimaryStyle}"
                                        Click="OnOpenUpgrade" />
                                <muxc:InfoBar x:Name="WalletInfo"
                                              Style="{StaticResource UrSnackbarStyle}"
                                              Margin="12,8" IsOpen="False" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <Border x:Name="WalletPaneBRule" Grid.Column="1"
                            Style="{StaticResource UrPaneVRuleStyle}" />

                    <!-- ============ PANE B: THE LEDGER ============ -->
                    <Grid Grid.Column="2" x:Name="WalletPaneB"
                          AutomationProperties.LandmarkType="Main">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource UrPaneHeaderStyle}" Padding="12,0">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <!-- the pane's own switch, in its own header
                                     strip: two tables, one at a time -->
                                <muxc:SelectorBar x:Name="EarningsTableBar"
                                                  VerticalAlignment="Center"
                                                  SelectionChanged="OnEarningsTableChanged">
                                    <muxc:SelectorBarItem x:Name="HistoryTabItem" />
                                    <muxc:SelectorBarItem x:Name="LeaderboardTabItem" />
                                </muxc:SelectorBar>
                                <TextBlock x:Name="WalletPaneBMeta" Grid.Column="1"
                                           HorizontalAlignment="Right"
                                           Style="{StaticResource UrPaneMetaStyle}" />
                            </Grid>
                        </Border>
                        <Grid Grid.Row="1">
                            <!-- HISTORY: one row per finalized epoch. Fills to the
                                 floor; its empty state is a centred line in that
                                 same full-height area. -->
                            <Grid x:Name="HistoryHost">
                                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="HistoryPanel" />
                                </ScrollViewer>
                                <TextBlock x:Name="HistoryStatusText"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           TextAlignment="Center" TextWrapping="Wrap"
                                           MaxWidth="320" Margin="16" IsHitTestVisible="False"
                                           Style="{StaticResource UrSupportingTextStyle}" />
                            </Grid>
                            <!-- LEADERBOARD. The same pane, the same floor. -->
                            <Grid x:Name="LeaderboardHost" Visibility="Collapsed">
                                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="LeaderboardRows" />
                                </ScrollViewer>
                                <TextBlock x:Name="LeaderboardStatusText"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           TextAlignment="Center" TextWrapping="Wrap"
                                           MaxWidth="320" Margin="16" IsHitTestVisible="False"
                                           Style="{StaticResource UrSupportingTextStyle}" />
                            </Grid>
                        </Grid>
                    </Grid>

                    <Border x:Name="WalletPaneCRule" Grid.Column="3"
                            Style="{StaticResource UrPaneVRuleStyle}" />

                    <!-- ============ PANE C: NETWORK ============ -->
                    <Grid Grid.Column="4" x:Name="WalletPaneC">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource UrPaneHeaderStyle}">
                            <Grid>
                                <TextBlock x:Name="WalletPaneCTitle"
                                           Style="{StaticResource UrPaneTitleStyle}" />
                            </Grid>
                        </Border>
                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- own ranking: the one thing you came to the
                                     leaderboard for, beside the table rather
                                     than above it -->
                                <Border Style="{StaticResource UrGroupHeaderStyle}">
                                    <TextBlock x:Name="LeaderboardRankLabel"
                                               Style="{StaticResource UrGroupHeaderTextStyle}" />
                                </Border>
                                <Border Style="{StaticResource UrPaneRowStyle}"
                                        MinHeight="0" Padding="12,12">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="LeaderboardNetProvidedLabel"
                                                   Style="{StaticResource UrKeyTextStyle}"
                                                   VerticalAlignment="Bottom" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                    Spacing="12" VerticalAlignment="Center">
                                            <TextBlock x:Name="LeaderboardNetProvidedValue"
                                                       FontFamily="{StaticResource UrBodyFontFamily}"
                                                       FontSize="18" FontWeight="SemiBold" />
                                            <TextBlock x:Name="LeaderboardRankValue"
                                                       FontFamily="{StaticResource UrBodyFontFamily}"
                                                       FontSize="22" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource UrPaneRowStyle}" MinHeight="44">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="LeaderboardPublicLabel"
                                                   Style="{StaticResource UrRowTitleStyle}" />
                                        <ToggleSwitch x:Name="LeaderboardPublicToggle"
                                                      Grid.Column="1" Width="44"
                                                      Style="{StaticResource UrSwitchToggleStyle}"
                                                      AutomationProperties.LabeledBy="{Binding ElementName=LeaderboardPublicLabel}"
                                                      Toggled="OnLeaderboardPublicToggled" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource UrPaneRowStyle}"
                                        MinHeight="0" Padding="12,8">
                                    <TextBlock x:Name="LeaderboardDescription" TextWrapping="Wrap"
                                               Style="{StaticResource UrRowNoteStyle}"
                                               TextTrimming="None" />
                                </Border>
                                <muxc:InfoBar x:Name="LeaderboardInfo"
                                              Style="{StaticResource UrSnackbarStyle}"
                                              Margin="12,8" IsOpen="False" />

                                <!-- earning multipliers: the Seeker token, points
                                     only ........................................ -->
                                <Border Style="{StaticResource UrGroupHeaderStyle}">
                                    <TextBlock x:Name="EarningMultipliersHeading"
                                               Style="{StaticResource UrGroupHeaderTextStyle}" />
                                </Border>
                                <Border BorderBrush="{StaticResource UrBorderBrush}"
                                        BorderThickness="0,0,0,1" Padding="12,10">
                                    <StackPanel Spacing="10">
                                        <TextBlock x:Name="SeekerStatusText" TextWrapping="Wrap"
                                                   Style="{StaticResource UrKeyTextStyle}"
                                                   TextTrimming="None" />
                                        <TextBlock x:Name="SeekerPointsOnlyText" TextWrapping="Wrap"
                                                   Style="{StaticResource UrRowNoteStyle}"
                                                   TextTrimming="None" />
                                        <Button x:Name="VerifySeekerButton"
                                                HorizontalAlignment="Stretch"
                                                Click="OnVerifySeeker" />
                                    </StackPanel>
                                </Border>

                                <!-- network reliability ........................ -->
                                <Border Style="{StaticResource UrGroupHeaderStyle}">
                                    <Grid>
                                        <TextBlock x:Name="NetworkReliabilityHeading"
                                                   Style="{StaticResource UrGroupHeaderTextStyle}" />
                                        <TextBlock x:Name="ReliabilityStatusText"
                                                   HorizontalAlignment="Right"
                                                   Style="{StaticResource UrPaneMetaStyle}" />
                                    </Grid>
                                </Border>
                                <Border x:Name="ReliabilityCard" Visibility="Collapsed"
                                        BorderBrush="{StaticResource UrBorderBrush}"
                                        BorderThickness="0,0,0,1" Padding="12,10">
                                    <StackPanel x:Name="ReliabilityPanel" Spacing="8" />
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- Support. Measured before this change: 0% card surface and
                     83% blank rows - the stars, the box and Send floated
                     directly on the page background with nothing holding them
                     together, which is the owner's "just buttons on a black
                     screen" in its purest form. It is now one card with a
                     glyphed header, an intro line and rules between the three
                     steps (rate, write, send), which is the shape Settings
                     already uses and the shape that reads best in the app. -->
                <ScrollViewer Margin="24" x:Name="SupportView" Visibility="Collapsed">
                  <!-- Three columns, weighted 1 : 1000 : 1, with the cap on the
                       middle one. The middle star is greedy enough to always
                       reach its MaxWidth when the window has the room, and the
                       two hairline stars split whatever is left - so the column
                       is CENTRED at wide widths and simply fills the viewport
                       at narrow ones, with no breakpoint and no branch.

                       Why not MaxWidth on the panel: that is the arrange-split
                       bug (the offset comes out of the child's DESIRED width
                       while it is laid out at the cap). Why not the single
                       capped column P4 used: it pins the content to x=0, which
                       is right at 1100 and lopsided when maximized - measured
                       2578px wide with 600px of content and ~1900px of void on
                       one side. -->
                  <!-- The same shape ConnectView carries. Support has ONE
                       form and no data, so at desktop widths the right half was
                       simply black - measured at 8% non-background pixels
                       maximized, the emptiest surface in the app. It now
                       carries the OTHER half of what this destination is for:
                       the form sends feedback to us, and the card beside it is
                       how you reach a human. Both strings already ship and were
                       used nowhere. -->
                  <Grid x:Name="SupportLayout">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="SupportCapColumn"
                                          Width="1000*" MaxWidth="560" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="1">
                      <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition x:Name="SupportSideColumn" Width="0" />
                      </Grid.ColumnDefinitions>
                      <Grid.RowDefinitions>
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0"
                                x:Name="SupportMainStack" Spacing="12"
                                VerticalAlignment="Top">
                        <!-- section header: glyph + name, the pattern every
                             destination now uses above its first card -->
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE9CE;" Style="{StaticResource UrRowIconStyle}" />
                            <TextBlock x:Name="FeedbackHeading" Style="{StaticResource UrPanelHeadingStyle}" />
                        </StackPanel>
                        <Border Style="{StaticResource UrCardStyle}">
                            <StackPanel Spacing="12">
                                <!-- why this screen exists, in one sentence.
                                     site_app_support_intro already ships and was
                                     used nowhere. -->
                                <TextBlock x:Name="SupportIntroText"
                                           Style="{StaticResource UrSupportingTextStyle}" />
                                <Border Style="{StaticResource UrDividerStyle}" />
                                <muxc:RatingControl x:Name="FeedbackRating" />
                                <Border Style="{StaticResource UrDividerStyle}" />
                                <TextBox x:Name="FeedbackText" AcceptsReturn="True" TextWrapping="Wrap"
                                         Style="{StaticResource UrTextInputStyle}"
                                         MinHeight="96" />
                                <!-- apple FeedbackView: logs go to the server ONLY from
                                     here, only when this is ticked, and only with the
                                     server-issued feedback id (SettingsPage).
                                     This box shipped with NO CONTENT AT ALL - an
                                     unlabelled checkbox offering to upload the
                                     user's logs, announced by a screen reader as
                                     "checkbox" and nothing else. The string
                                     (feedback_include_logs) was already in the
                                     store. -->
                                <CheckBox x:Name="FeedbackIncludeLogs" />
                                <Border Style="{StaticResource UrDividerStyle}" />
                                <Button x:Name="SendFeedbackButton" Click="OnSendFeedback"
                                        HorizontalAlignment="Right">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE724;" Style="{StaticResource UrRowIconStyle}"
                                                  FontSize="14" />
                                        <TextBlock x:Name="SendFeedbackText" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                        <muxc:InfoBar x:Name="SupportInfo" Style="{StaticResource UrSnackbarStyle}" IsOpen="False" />
                    </StackPanel>

                    <!-- REACHING A HUMAN. The feedback form is one-way; this is
                         the other way, and support@ur.io and the Discord invite
                         were already in the store
                         (if_the_problem_persists_contact_us_at_support_ur) with
                         no call site anywhere in the client. Rendered with its
                         links inline by urnw::SetMarkdownLinkText, so the whole
                         shipped sentence survives and both links are real
                         Hyperlinks in the tab order. -->
                    <StackPanel Grid.Row="1" Grid.Column="0"
                                x:Name="SupportSideStack" Spacing="12"
                                VerticalAlignment="Top" Margin="0,16,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE939;" Style="{StaticResource UrRowIconStyle}" />
                            <TextBlock x:Name="SupportContactHeading"
                                       Style="{StaticResource UrPanelHeadingStyle}" />
                        </StackPanel>
                        <Border Style="{StaticResource UrCardStyle}">
                            <StackPanel Spacing="12">
                                <TextBlock x:Name="SupportContactText" TextWrapping="Wrap" />
                                <Border Style="{StaticResource UrDividerStyle}" />
                                <HyperlinkButton x:Name="SupportProtocolLink"
                                                 NavigateUri="https://ur.xyz"
                                                 FontSize="12" Padding="0"
                                                 HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    </Grid>
                  </Grid>
                </ScrollViewer>

                <!-- ==== SETTINGS: THE PANE SHELL (R4) ======================
                     Slimmed to PREFERENCES. Account, subscription, login
                     methods, the auth code, the client id, referral code,
                     referral network, sign out and delete account all left for
                     the Account destination (spec override #2).

                     Windows guidance wants settings as a single constrained
                     column of rows, and the pane model wants full bleed with no
                     max-width cap. Those are reconciled by making each pane a
                     constrained column: THREE equal star columns, so at the
                     2062dip window this app is judged in each one is ~660dip -
                     which is the settings measure the guidance is asking for -
                     and together they cover the window edge to edge with no
                     centring grid and no gutter.

                       col 0  GENERAL   preferences, then VPN and privacy
                       col 2  DEVICE    this machine, then Advanced
                       col 4  ABOUT     version, community, the protocol

                     A list-pane-plus-detail reading was the other legitimate
                     option. It was rejected because there are ~14 preference
                     rows in the whole product: a navigation column for five
                     sections of three rows spends a third of the window on a
                     table of contents for a page that fits on one screen.

                     Every row here is built by SettingsPage into the three
                     hosts below, through the row kit in pane mode. -->
                <Grid x:Name="SettingsView" Visibility="Collapsed"
                      Style="{StaticResource UrPaneStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="SettingsPaneAColumn" Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition x:Name="SettingsPaneBColumn" Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition x:Name="SettingsPaneCColumn" Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- ============ PANE A: GENERAL / VPN AND PRIVACY ======= -->
                    <Grid Grid.Column="0" x:Name="SettingsPaneA"
                          AutomationProperties.LandmarkType="Main">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource UrPaneHeaderStyle}">
                            <Grid>
                                <TextBlock x:Name="SettingsPaneATitle"
                                           Style="{StaticResource UrPaneTitleStyle}" />
                            </Grid>
                        </Border>
                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="SettingsSections" />
                        </ScrollViewer>
                    </Grid>

                    <Border x:Name="SettingsPaneBRule" Grid.Column="1"
                            Style="{StaticResource UrPaneVRuleStyle}" />

                    <!-- ============ PANE B: DEVICE / ADVANCED =============== -->
                    <Grid Grid.Column="2" x:Name="SettingsPaneB">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource UrPaneHeaderStyle}">
                            <Grid>
                                <TextBlock x:Name="SettingsPaneBTitle"
                                           Style="{StaticResource UrPaneTitleStyle}" />
                            </Grid>
                        </Border>
                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="SettingsSectionsRight" />
                        </ScrollViewer>
                    </Grid>

                    <Border x:Name="SettingsPaneCRule" Grid.Column="3"
                            Style="{StaticResource UrPaneVRuleStyle}" />

                    <!-- ============ PANE C: ABOUT =========================== -->
                    <Grid Grid.Column="4" x:Name="SettingsPaneC">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource UrPaneHeaderStyle}">
                            <Grid>
                                <TextBlock x:Name="SettingsPaneCTitle"
                                           Style="{StaticResource UrPaneTitleStyle}" />
                            </Grid>
                        </Border>
                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="SettingsAboutHost" />
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- Developer / reliability (P2). The ~40 controls are still
                     built by urnw::DeveloperPage in code; what lives here is
                     only the SHAPE, because D4 made that shape the same on all
                     seven destinations and it belongs where the other six are.
                     The page appends its cards into the four named hosts.

                     Portmaster's reading: the wide tables at the top, then
                     key-value material in columns under them. Exits has seven
                     columns and Destinations three; both take the full width of
                     the composition at every size, and both will grow id / raw
                     columns under Advanced Mode. -->
                <ScrollViewer Margin="24" x:Name="DeveloperView" Visibility="Collapsed"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                  <Grid x:Name="DeveloperLayout">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="DeveloperCapColumn"
                                          Width="1000*" MaxWidth="1000" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="1">
                      <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition x:Name="DeveloperSideColumn" Width="0" />
                      </Grid.ColumnDefinitions>
                      <Grid.RowDefinitions>
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>
                      <!-- what these tools are, and the two actions that need
                           no session -->
                      <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                  x:Name="DeveloperTopStack" Spacing="16" />
                      <!-- the two tables, full width -->
                      <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                  x:Name="DeveloperTablesStack" Spacing="16"
                                  Margin="0,16,0,0" />
                      <!-- what the session has measured -->
                      <StackPanel Grid.Row="2" Grid.Column="0"
                                  x:Name="DeveloperMainStack" Spacing="16"
                                  VerticalAlignment="Top" Margin="0,16,0,24" />
                      <!-- the five override sections -->
                      <StackPanel Grid.Row="3" Grid.Column="0"
                                  x:Name="DeveloperSideStack" Spacing="16"
                                  VerticalAlignment="Top" Margin="0,16,0,24" />
                    </Grid>
                  </Grid>
                </ScrollViewer>
            </Grid>
        </muxc:NavigationView>

        <!-- The standing reason this app is not carrying traffic (rpc-only, or
             a session that could not be started). Driven by DeveloperPage from
             SdkHost::SetModeNoticeHandler. Window level, not page level: it is
             true whichever destination is on screen. IsClosable is set in code
             and is never true - this is a property of the session, not an
             event, and it stays until it is replaced. -->
        <muxc:InfoBar x:Name="ModeNoticeBar" Grid.Row="2" IsOpen="False"
                      IsClosable="False" Margin="0"
                      FontFamily="{StaticResource UrBodyFontFamily}" />
        <!-- Acknowledgements that belong to the window rather than to a
             destination - today the account menu's "referral link copied". A
             copy with no visible result is indistinguishable from a copy that
             did not happen, which is why this exists at all. It floats over
             whichever panel is showing and dismisses itself (kit::Snackbar). -->
        <muxc:InfoBar x:Name="AccountSnackbar" Grid.Row="1"
                      Style="{StaticResource UrSnackbarStyle}"
                      VerticalAlignment="Bottom" HorizontalAlignment="Center"
                      Margin="24" MaxWidth="480" IsOpen="False" />

        <!-- THE STATUS STRIP (D4). ProtonVPN's bottom line - IP / country /
             provider - is the one piece of their chrome that is neither
             navigation nor hero: a quiet, always-true statement of what the
             client is doing, which does not go away when the user wanders off
             to Wallet. This app had no such thing; the connection state existed
             only on Connect, so five of the seven destinations gave no way at
             all to tell whether traffic was flowing.
             It is WINDOW level, like ModeNoticeBar above it, because that is
             what "regardless of destination" means.

             The fields are built in code (MainWindow::BuildStatusStrip) from
             kit::MakeStatusField rather than spelled out here, because the
             product tiering decision makes this the flagship Advanced Mode
             surface: Normal is the three fields below, Advanced adds egress
             interface, rpc port, session mode and the raw pre-clamp connection
             status to the SAME row. A horizontal panel of uniform fields takes
             four more; a hand-built Grid of fixed columns would not.

             HorizontalScrollMode is Disabled and every value trims rather than
             wraps: a status strip that becomes two rows tall, or that scrolls,
             has stopped being chrome. -->
        <!-- Border is not a Control, so it carries no FontFamily to inherit
             from: the two field styles name the body face themselves. -->
        <Border x:Name="StatusStrip" Grid.Row="3" Visibility="Collapsed"
                Style="{StaticResource UrStatusStripStyle}">
            <StackPanel x:Name="StatusStripFields" Orientation="Horizontal"
                        Spacing="0" VerticalAlignment="Center" />
        </Border>

        <!-- REFERRAL CROWNING. One-time full-window gold celebration when the
             network's first referral lands (the ur.io referral king frog).
             Later referrals get ReferralSnackbar instead. All text is set in
             code (MainWindow::OnReferralCelebration); the aura pulse is a
             code-built animation so reduced-motion can skip it. Spans every
             row on purpose: a crowning covers the whole window. -->
        <Grid x:Name="ReferralCelebrationOverlay" Grid.Row="0" Grid.RowSpan="4"
              Visibility="Collapsed" Background="#F5101010">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Spacing="16" MaxWidth="400" Margin="24,48">
                    <Grid HorizontalAlignment="Center" Width="240" Height="240">
                        <Ellipse x:Name="ReferralCelebrationAura" Width="240" Height="240">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="#47F5B93C" Offset="0" />
                                    <GradientStop Color="#00F5B93C" Offset="1" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Image Source="ms-appx:///Assets/ReferralFrog.png"
                               Width="144" Height="144"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               AutomationProperties.AccessibilityView="Raw" />
                    </Grid>
                    <TextBlock x:Name="ReferralCelebrationTitle" TextWrapping="Wrap"
                               TextAlignment="Center"
                               Style="{StaticResource UrTitleTextStyle}"
                               Foreground="{StaticResource UrReferralGoldLightBrush}" />
                    <TextBlock x:Name="ReferralCelebrationDetail" TextWrapping="Wrap"
                               TextAlignment="Center"
                               Style="{StaticResource UrBodyTextStyle}" />
                    <Border Background="#59000000"
                            BorderBrush="{StaticResource UrReferralGoldBrush}"
                            BorderThickness="1" CornerRadius="22" Padding="18,8">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ReferralCelebrationCode"
                                       FontWeight="Bold" FontSize="18"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       FontFamily="{StaticResource UrBodyFontFamily}"
                                       Foreground="{StaticResource UrReferralGoldLightBrush}" />
                            <Button x:Name="ReferralCelebrationCopy" Grid.Column="1"
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="{StaticResource UrReferralGoldLightBrush}" />
                        </Grid>
                    </Border>
                    <Button x:Name="ReferralCelebrationShare" HorizontalAlignment="Stretch"
                            Background="{StaticResource UrReferralGoldBrush}"
                            Foreground="{StaticResource UrReferralGoldInkBrush}"
                            FontFamily="{StaticResource UrBodyFontFamily}" FontWeight="Bold"
                            CornerRadius="22" Padding="0,10" />
                </StackPanel>
            </ScrollViewer>
            <Button x:Name="ReferralCelebrationClose" HorizontalAlignment="Right"
                    VerticalAlignment="Top" Margin="16"
                    Background="Transparent" BorderThickness="0">
                <FontIcon Glyph="&#xE711;" FontSize="14" />
            </Button>
        </Grid>

        <!-- the post-sign-up onboarding flow (Onboarding.cpp builds its four
             pages into this grid; shown once, right after a network is created) -->
        <Grid x:Name="OnboardingOverlay" Grid.Row="1" Grid.RowSpan="3"
              Visibility="Collapsed" Background="{StaticResource UrBackgroundBrush}" />

        <!-- the referral gold toast: a friend joined with your code, for
             referrals after the first (kit::Snackbar on the gold style) -->
        <muxc:InfoBar x:Name="ReferralSnackbar" Grid.Row="1"
                      Style="{StaticResource UrGoldSnackbarStyle}"
                      VerticalAlignment="Bottom" HorizontalAlignment="Center"
                      Margin="24" MaxWidth="480" IsOpen="False" />
    </Grid>
</Window>
