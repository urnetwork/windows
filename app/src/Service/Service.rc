// SPDX-License-Identifier: MPL-2.0
//
// The service's only resource: its version stamp. This exists for more than
// Explorer's Details tab — the app's ServiceSetup classifies VersionMismatch
// by comparing the file version resource of the INSTALLED service exe (the
// SCM's binPath) against the urnetworkd.exe sitting next to the app, so an
// unstamped service binary would be invisible to the update flow.
//
// UR_VER_* / UR_VERSION_STRING come from Version.h, which takes them from the
// UR_* definitions Directory.Build.props feeds rc.exe — the same values the
// code compiles against. The fourth numeric field is a permanent 0: the date
// parts alone name a release, and the numeric code travels in the
// ProductVersion STRING (the full grammar), where VerQueryValue readers parse
// it back out.
#include <winresrc.h>
#include "..\Common\Version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    UR_VER_MAJOR,UR_VER_MINOR,UR_VER_PATCH,0
 PRODUCTVERSION UR_VER_MAJOR,UR_VER_MINOR,UR_VER_PATCH,0
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // 040904B0 = en-US, Unicode — must agree with the Translation value
        // below or Explorer finds no strings at all.
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "URnetwork"
            VALUE "FileDescription",  "URnetwork VPN service"
            VALUE "FileVersion",      UR_VERSION_STRING
            VALUE "InternalName",     "urnetworkd"
            VALUE "LegalCopyright",   "URnetwork. Licensed under MPL-2.0."
            VALUE "OriginalFilename", "urnetworkd.exe"
            VALUE "ProductName",      "URnetwork"
            VALUE "ProductVersion",   UR_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
