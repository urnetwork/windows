<?xml version="1.0" encoding="utf-8"?>
<!-- urnetworkd — the URnetwork Windows service. SPDX-License-Identifier: MPL-2.0 -->
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64"><Configuration>Debug</Configuration><Platform>x64</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64"><Configuration>Release</Configuration><Platform>x64</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="Debug|ARM64"><Configuration>Debug</Configuration><Platform>ARM64</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="Release|ARM64"><Configuration>Release</Configuration><Platform>ARM64</Platform></ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <VCProjectVersion>17.0</VCProjectVersion>
    <ProjectGuid>{A1B2C3D4-0002-4E5F-8A9B-000000000002}</ProjectGuid>
    <RootNamespace>urnetworkd</RootNamespace>
    <TargetName>urnetworkd</TargetName>  <!-- urnetworkd.exe (the WiX ServiceInstall expects it) -->
    <ConfigurationType>Application</ConfigurationType>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Label="Configuration">
    <UseDebugLibraries Condition="'$(Configuration)'=='Debug'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(Configuration)'=='Release'">false</UseDebugLibraries>
    <WholeProgramOptimization Condition="'$(Configuration)'=='Release'">true</WholeProgramOptimization>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />

  <ItemDefinitionGroup>
    <ClCompile>
      <!-- DYNAMIC CRT (MD) to match Common.lib (which is /MD for the WinUI App); the CRT
           flavor must be identical across a binary and the static libs it links. -->
      <RuntimeLibrary Condition="'$(Configuration)'=='Debug'">MultiThreadedDebugDLL</RuntimeLibrary>
      <RuntimeLibrary Condition="'$(Configuration)'=='Release'">MultiThreadedDLL</RuntimeLibrary>
      <Optimization Condition="'$(Configuration)'=='Release'">MaxSpeed</Optimization>
      <!-- wintun.h ships beside the vendored wintun.dll under third_party -->
      <AdditionalIncludeDirectories>$(UrnWintunDir);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <AdditionalLibraryDirectories>$(UrnSdkDir);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>URnetworkSdk.lib;iphlpapi.lib;wlanapi.lib;ws2_32.lib;advapi32.lib;shell32.lib;ntdll.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
    <!-- copy the SDK dll (and wintun) next to the service exe for local runs -->
    <PostBuildEvent>
      <Command>copy /y "$(UrnSdkDir)URnetworkSdk.dll" "$(OutDir)" &amp; copy /y "$(UrnWintunDir)bin\$(UrnSdkArch)\wintun.dll" "$(OutDir)"</Command>
    </PostBuildEvent>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ClCompile Include="main.cpp" />
    <ClCompile Include="ControlServer.cpp" />
    <ClCompile Include="TunnelController.cpp" />
    <ClCompile Include="TunnelWatchdog.cpp" />
    <ClCompile Include="Wintun.cpp" />
    <ClCompile Include="PacketPump.cpp" />
    <ClCompile Include="NetworkConfig.cpp" />
    <ClCompile Include="EgressMonitor.cpp" />
    <ClCompile Include="SplitTunnelClient.cpp" />
    <ClCompile Include="WfpPolicy.cpp" />
    <ClCompile Include="WindowTrace.cpp" />
    <ClCompile Include="FlowOwner.cpp" />
    <ClCompile Include="ServiceDiagnostics.cpp" />
    <ClCompile Include="SelfTest.cpp" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="AppLogHandles.h" />
    <ClInclude Include="ConsoleArgs.h" />
    <ClInclude Include="ControlServer.h" />
    <ClInclude Include="InstallVerb.h" />
    <ClInclude Include="TunnelController.h" />
    <ClInclude Include="DeadTunnelVerdict.h" />
    <ClInclude Include="TunnelWatchdog.h" />
    <ClInclude Include="TunnelWatchdogSettings.h" />
    <ClInclude Include="NetworkChangeNotify.h" />
    <ClInclude Include="CaptureReadiness.h" />
    <ClInclude Include="Wintun.h" />
    <ClInclude Include="WintunError.h" />
    <ClInclude Include="PacketPump.h" />
    <ClInclude Include="NetworkConfig.h" />
    <ClInclude Include="NetPolicy.h" />
    <ClInclude Include="EgressMonitor.h" />
    <ClInclude Include="SplitTunnelClient.h" />
    <ClInclude Include="WfpPolicy.h" />
    <ClInclude Include="WindowTrace.h" />
    <ClInclude Include="FlowOwner.h" />
    <ClInclude Include="ServiceDiagnostics.h" />
    <ClInclude Include="SelfTest.h" />
    <ClInclude Include="StopBudget.h" />
  </ItemGroup>
  <ItemGroup>
    <!-- VERSIONINFO only (see Service.rc for why the service is stamped) -->
    <ResourceCompile Include="Service.rc" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Common\Common.vcxproj">
      <Project>{A1B2C3D4-0001-4E5F-8A9B-000000000001}</Project>
    </ProjectReference>
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />

  <!-- App-local VC++ runtime. urnetworkd and the app link the DLL CRT (/MD, see
       above), and a self-contained unpackaged Windows App SDK app does not carry
       the VC++ runtime: Microsoft requires the VC++ Redistributable on the target
       machine. Neither the MSI nor the portable zip installed it, so on a machine
       without it urnetworkd.exe cannot load and the MSI's ServiceControl start
       fails the whole install ("Service 'URnetwork Service' (urnetworkd) failed
       to start", error 1920). Copy the toolset's own redistributable CRT DLLs
       into $(OutDir), the BinDir the MSI harvests and package-portable.ps1 zips;
       the exe's directory is searched first, so the app and service load these.
       Release only: the debug CRT is not redistributable. -->
  <PropertyGroup>
    <UrnVCRuntimeArch Condition="'$(Platform)'=='x64'">x64</UrnVCRuntimeArch>
    <UrnVCRuntimeArch Condition="'$(Platform)'=='ARM64'">arm64</UrnVCRuntimeArch>
  </PropertyGroup>
  <Target Name="UrnStageVCRuntime" AfterTargets="Build" Condition="'$(Configuration)'=='Release'">
    <ItemGroup>
      <UrnVCRuntime Include="$(VCToolsRedistInstallDir)$(UrnVCRuntimeArch)\Microsoft.VC*.CRT\*.dll" />
    </ItemGroup>
    <Error Condition="'@(UrnVCRuntime)'==''"
           Text="VC++ runtime DLLs not found under $(VCToolsRedistInstallDir)$(UrnVCRuntimeArch)\Microsoft.VC*.CRT (install the MSVC v143 toolset's redistributable); without them urnetworkd cannot start on a machine lacking the VC++ Redistributable" />
    <Copy SourceFiles="@(UrnVCRuntime)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
