# build outputs
build/
[Bb]in/
[Oo]bj/
x64/
ARM64/
*.user
.vs/

# vcpkg / nuget
packages/
vcpkg_installed/

# vendored binaries (fetched by tools/fetch-deps.ps1)
third_party/urnetwork-sdk/*/
third_party/wintun/bin/
# pinned upstream zips cached across builds (fetch-deps.ps1 re-verifies the
# sha256 every run, so the cache is a speed/reliability win, not a trust one)
third_party/cache/
third_party/wintun/wintun.h
third_party/wintun/wintun-license.txt
third_party/vendor-include/

# generated by the XAML compiler into the source dir
src/App/XamlMetaDataProvider.cpp
src/App/XamlMetaDataProvider.idl

# tools/build-local.ps1 output
msbuild-local-*.log

# app icons (.ico) ARE committed — generated from the macOS brand art by
# tools/make-icons.py; small, stable, and needed at build time.
