<?xml version="1.0" encoding="utf-8"?>
<!-- URnetwork MSI (WiX v5). Installs the tray app, the urnetworkd service, the
     vendored wintun DLL, the self-contained WindowsAppRuntime/WinUI3 payload,
     the brand Assets (Fonts + images), and (optionally) the split-tunnel
     driver. Per-machine.

     There is no outer Burn bundle anywhere in this repo -- this file used to
     say the WindowsAppRuntime was "chained by the outer bundle (see
     README)", but that bundle was never built, so until this fix the MSI
     installed exactly 7 files and left the app unable to start on any
     machine that had not already run the portable zip (which is why testing
     against a dev box missed it). Since WindowsAppSDKSelfContained=true
     landed, the runtime DLLs are this package's own payload: harvested below
     with WiX v5's native <Files> globbing against $(var.BinDir) -- the same
     directory tools/package-portable.ps1 zips wholesale -- rather than
     hand-listed, because a hand list rots the moment the runtime version
     bumps (that rot is exactly how this MSI ended up here).

     Distributed via the Microsoft Store as a Win32 MSI.
     SPDX-License-Identifier: MPL-2.0 -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:fw="http://wixtoolset.org/schemas/v4/wxs/firewall">

  <!-- Version comes from the .wixproj (UrMsiVersion, yy.M.d from CI; 0.0.1
       for a bare local build) because ProductVersion fields cannot hold the
       app's four-digit year. -->
  <Package Name="URnetwork" Manufacturer="URnetwork" Version="$(var.UrMsiVersion)"
           UpgradeCode="a7c1e2d3-4b5f-6081-9c2d-3e4f50617283"
           Scope="perMachine" Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of URnetwork is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- The app icon, for Add/Remove Programs and the Start Menu shortcut.
         Referenced from the SOURCE tree, not BinDir: BinDir carries whatever
         the app build staged for runtime, and the installer should not depend
         on which assets that happens to include. -->
    <Icon Id="AppIcon.ico" SourceFile="$(sys.SOURCEFILEDIR)..\src\App\Assets\app.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />

    <!-- Build binaries are staged under $(var.BinDir) by the .wixproj. -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="URnetwork">

        <!-- Tray app + SDK -->
        <Component Id="AppExe" Guid="*">
          <File Id="URnetworkExe" Source="$(var.BinDir)\URnetwork.exe" KeyPath="yes" />
          <!-- Start Menu entry, so the installed app is launchable the way a
               normal Windows app is (owner report: without one the MSI leaves
               the exe reachable only by path). It lives in THIS component so
               the exe File stays the KeyPath, and it is ADVERTISED because
               that is the one shortcut shape validation accepts here: ICE43/
               ICE57 call any non-advertised shortcut per-user data, even in a
               perMachine package, and the alternative is a new HKCU-keypath
               component — wrong for a per-machine install. An advertised
               shortcut resolves to this component's keypath (the exe) and
               needs no Target. No desktop shortcut on purpose. -->
          <Shortcut Id="StartMenuShortcut" Name="URnetwork" Advertise="yes"
                    Directory="ProgramMenuFolder"
                    WorkingDirectory="INSTALLFOLDER" Icon="AppIcon.ico" />
        </Component>
        <Component Id="SdkDll" Guid="*">
          <File Id="URnetworkSdkDll" Source="$(var.BinDir)\URnetworkSdk.dll" KeyPath="yes" />
        </Component>

        <!-- Localized UI strings: the MakePri index of Strings\<locale>\Resources.resw
             (generated from urnetwork/localizations). The app is unpackaged, so there
             is no package to carry it — MRT Core loads it by path from next to the exe,
             and without it every string renders as its key id. -->
        <Component Id="ResourcesPri" Guid="*">
          <File Id="resourcesPri" Source="$(var.BinDir)\resources.pri" KeyPath="yes" />
        </Component>

        <!-- Service + wintun -->
        <Component Id="ServiceExe" Guid="*">
          <File Id="urnetworkdExe" Source="$(var.BinDir)\urnetworkd.exe" KeyPath="yes" />
          <!-- Register urnetworkd as an auto-start LocalSystem service. -->
          <ServiceInstall Id="UrnetworkdService" Name="urnetworkd"
                          DisplayName="URnetwork Service" Type="ownProcess"
                          Start="auto" ErrorControl="normal"
                          Description="Runs the URnetwork VPN tunnel."
                          Account="LocalSystem">
            <ServiceConfig DelayedAutoStart="no" OnInstall="yes" OnReinstall="yes" />
            <!-- restart on crash (plan M4) -->
            <util:ServiceConfig xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util"
                                FirstFailureActionType="restart"
                                SecondFailureActionType="restart"
                                ThirdFailureActionType="none"
                                RestartServiceDelayInSeconds="5" ResetPeriodInDays="1" />
          </ServiceInstall>
          <ServiceControl Id="UrnetworkdControl" Name="urnetworkd"
                          Start="install" Stop="both" Remove="uninstall" Wait="yes" />
        </Component>
        <Component Id="WintunDll" Guid="*">
          <File Id="wintunDll" Source="$(var.BinDir)\wintun.dll" KeyPath="yes" />
        </Component>

        <!-- Third-party attributions: the notices index (checked in) + Wintun's
             verbatim prebuilt-binaries license (staged by tools/fetch-deps.ps1). -->
        <!-- One file per component: WiX auto-GUID ('*') requires a single file (or a
             versioned keypath), so these two unversioned .txt files must be separate
             components (else WIX0367). -->
        <Component Id="ThirdPartyNotices" Guid="*">
          <File Id="ThirdPartyNoticesTxt" Source="$(sys.SOURCEFILEDIR)..\THIRD-PARTY-NOTICES.txt" KeyPath="yes" />
        </Component>
        <Component Id="WintunLicense" Guid="*">
          <File Id="WintunLicenseTxt" Source="$(sys.SOURCEFILEDIR)..\third_party\wintun\wintun-license.txt" KeyPath="yes" />
        </Component>

        <!-- Split-tunnel driver payload. The MSI only lays down the .sys; the
             urnetworkd service (LocalSystem) registers + starts it on demand and
             stops + deletes it on teardown (SplitTunnelClient). Windows Installer
             can't host a kernel-driver service (SERVICE_KERNEL_DRIVER is not a
             valid ServiceInstall type). Attestation-signed in production.
             Compiled in only when the driver was built: -p:IncludeDriver=true on
             the .wixproj (build.ps1 -IncludeDriver) defines IncludeDriver. Without
             it the WFP driver / split tunneling is omitted and the .sys need not
             exist at package time. -->
        <?ifdef IncludeDriver ?>
        <Component Id="SplitTunnelDriver" Guid="*" Condition="INSTALLDRIVER=1">
          <File Id="SplitTunnelSys" Source="$(var.BinDir)\SplitTunnel.sys" KeyPath="yes" />
        </Component>
        <?endif?>

      </Directory>
    </StandardDirectory>

    <!-- Everything else the app needs to actually start: the self-contained
         WindowsAppRuntime/WinUI3 runtime (Microsoft.*.dll / .winmd, the
         per-locale .mui satellites), the app's own compiled XAML
         (App.xbf/MainWindow.xbf) and WinRT metadata (URnetwork.winmd), and
         the brand Assets -- Fonts (the licensed faces; see
         src/App/Assets/README.md) plus the icons/login-carousel images.
         Roughly 290 files as of WindowsAppSDK 2.2 self-contained, none of
         which are safe to hand-list (see the header comment). Harvested
         straight from $(var.BinDir), the identical directory
         tools/package-portable.ps1 zips as the portable build, so this
         payload and the zip's payload cannot drift apart.

         The five files above (AppExe/SdkDll/ResourcesPri/ServiceExe/
         WintunDll) keep their own hand-authored <Component> because they
         need behavior <Files> harvesting cannot express -- the advertised
         Start Menu shortcut and the ServiceInstall/ServiceControl rows --
         so they are excluded here to avoid installing each of them twice
         (WiX rejects two components claiming the same target path).
         SplitTunnelDriver is excluded for the same reason: it is
         conditioned on INSTALLDRIVER=1 and must not be unconditionally
         harvested when -IncludeDriver built the .sys into BinDir. Build
         junk (.pdb/.lib/.exp/.ilk, any obj\ tree) is excluded to match
         package-portable.ps1's own exclusions exactly. -->
    <ComponentGroup Id="RuntimeFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.BinDir)\**"
             Exclude="$(var.BinDir)\URnetwork.exe;$(var.BinDir)\URnetworkSdk.dll;$(var.BinDir)\resources.pri;$(var.BinDir)\urnetworkd.exe;$(var.BinDir)\wintun.dll;$(var.BinDir)\SplitTunnel.sys;$(var.BinDir)\**\*.pdb;$(var.BinDir)\**\*.lib;$(var.BinDir)\**\*.exp;$(var.BinDir)\**\*.ilk;$(var.BinDir)\**\obj\**" />
    </ComponentGroup>

    <!-- urnetwork:// protocol handler (OAuth callbacks + deep links) -->
    <StandardDirectory Id="TARGETDIR">
      <Component Id="UriScheme" Guid="*">
        <RegistryKey Root="HKLM" Key="Software\Classes\urnetwork">
          <RegistryValue Type="string" Value="URL:URnetwork Protocol" />
          <RegistryValue Name="URL Protocol" Type="string" Value="" />
          <RegistryKey Key="shell\open\command">
            <RegistryValue Type="string" Value="&quot;[INSTALLFOLDER]URnetwork.exe&quot; &quot;%1&quot;" />
          </RegistryKey>
        </RegistryKey>
      </Component>
    </StandardDirectory>

    <Feature Id="Main" Title="URnetwork" Level="1">
      <ComponentRef Id="AppExe" />
      <ComponentRef Id="SdkDll" />
      <ComponentRef Id="ResourcesPri" />
      <ComponentRef Id="ServiceExe" />
      <ComponentRef Id="WintunDll" />
      <ComponentRef Id="ThirdPartyNotices" />
      <ComponentRef Id="WintunLicense" />
      <ComponentRef Id="UriScheme" />
      <ComponentGroupRef Id="RuntimeFiles" />
    </Feature>
    <?ifdef IncludeDriver ?>
    <Feature Id="SplitTunnel" Title="Per-app split tunneling" Level="1">
      <ComponentRef Id="SplitTunnelDriver" />
    </Feature>

    <Property Id="INSTALLDRIVER" Value="1" />
    <?endif?>
  </Package>
</Wix>
